}

export function Surface({
  className,
  children,
  padded = "md",
  subdued = false,
  tone = "default",
  shadow = "none",
}) {
  const variant = resolveSurfaceVariant({ tone, subdued });
  const resolvedTone = resolveSurfaceTone({ tone });

  return (
    <Card
      variant={variant}
      tone={resolvedTone}
      padded={padded}
      className={className}
      outerClassName={cx(
        shadow === "md" && "ui-card--elevated",
        shadow === "none" && ""
      )}
    >
      {children}
    </Card>
  );
}

export function MetricCard({
  label,
  value,
  hint,
  tone = "neutral",
  className,
}) {
  return (
    <Card
      tone={metricTone(tone)}
      padded="sm"
      className={cx("px-4 py-4.5", className)}
    >
      {label ? (
        <div className="text-[11px] font-semibold uppercase tracking-[0.1em] text-text-subtle">
          {label}
        </div>
      ) : null}

      <div className="mt-2 text-[1.38rem] font-semibold leading-tight tracking-[var(--tracking-tight-lg)] text-text">
        {value}
      </div>

      {hint ? (
        <div className="mt-1.5 text-[12.5px] font-medium leading-5 text-text-muted">
          {hint}
        </div>
      ) : null}
    </Card>
  );
}

export function MetricGrid({ className, children, columns = 4 }) {
  const columnsClass =
    columns === 2
      ? "md:grid-cols-2"
      : columns === 3
        ? "md:grid-cols-3"
        : "md:grid-cols-2 xl:grid-cols-4";

  return <div className={cx("grid gap-4", columnsClass, className)}>{children}</div>;
}

export function LaunchStatusBadge({
  tone = "neutral",
  children,
  dot = true,
  className,
}) {
  const dotClass =
    tone === "success"
      ? "bg-success"
      : tone === "warning"
        ? "bg-warning"
        : tone === "danger"
          ? "bg-danger"
          : tone === "info" || tone === "brand"
            ? "bg-brand"
            : "bg-[rgb(var(--color-text-soft))]";

  return (
    <Badge
      tone={tone}
      size="sm"
      className={cx("!min-h-[25px] !px-2.5 !text-[11.5px]", className)}
    >
      {dot ? <span className={cx("h-1.5 w-1.5 rounded-full", dotClass)} /> : null}
      {children}
    </Badge>
  );
}

export function LaunchTextAction({
  children = "Details",
