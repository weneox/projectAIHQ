@tailwind base;
@tailwind components;
@tailwind utilities;

/* ==========================================================================
   NEOX UI FOUNDATION
   Single visual language for typography, material, controls, radius, motion.
   ========================================================================== */

:root {
  color-scheme: light;

  /* Typography */
  --font-sans:
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  --font-display: var(--font-sans);

  --font-weight-regular: 450;
  --font-weight-medium: 520;
  --font-weight-semibold: 620;
  --font-weight-bold: 700;

  --tracking-tight-xs: -0.008em;
  --tracking-tight-sm: -0.012em;
  --tracking-tight-md: -0.018em;
  --tracking-tight-lg: -0.03em;
  --tracking-tight-xl: -0.055em;

  --line-tight: 1.05;
  --line-title: 1.15;
  --line-body: 1.5;
  --line-relaxed: 1.68;

  /* Canvas */
  --color-canvas: 250 251 253;
  --color-canvas-muted: 246 248 251;
  --color-canvas-raised: 255 255 255;

  /* Surfaces */
  --color-surface: 255 255 255;
  --color-surface-muted: 249 250 252;
  --color-surface-subtle: 244 247 251;
  --color-surface-pressed: 238 243 249;
  --color-surface-inverse: 10 15 25;

  /* Text */
  --color-text: 12 18 30;
  --color-text-muted: 51 65 85;
  --color-text-subtle: 92 105 123;
  --color-text-soft: 130 144 162;
  --color-text-inverse: 248 250 252;

  /* Lines */
  --color-line: 214 221 232;
  --color-line-strong: 185 196 211;
  --color-line-soft: 230 235 242;
  --color-line-faint: 241 244 248;

  /* Brand */
  --color-brand: 46 96 255;
  --color-brand-strong: 31 80 232;
  --color-brand-soft: 239 244 255;
  --color-brand-faint: 246 249 255;

  /* Semantic */
  --color-info: 46 96 255;
  --color-info-soft: 239 244 255;

  --color-success: 21 128 61;
  --color-success-strong: 5 150 105;
  --color-success-soft: 240 253 244;

  --color-warning: 180 83 9;
  --color-warning-strong: 217 119 6;
  --color-warning-soft: 255 247 237;

  --color-danger: 190 24 93;
  --color-danger-strong: 159 18 57;
  --color-danger-soft: 253 242 248;

  --color-overlay: 15 23 42;

  /* Radius */
  --radius-xs: 3px;
  --radius-sm: 4px;
  --radius-md: 6px;
  --radius-lg: 8px;
  --radius-xl: 10px;
  --radius-2xl: 12px;
  --radius-3xl: 14px;
  --radius-pill: 8px;

  --ui-radius-control-outer: 6px;
  --ui-radius-control-inner: 4px;
  --ui-radius-button: 6px;
  --ui-radius-badge: 5px;

  --ui-control-radius-outer: 6px;
  --ui-control-radius-inner: 4px;

  /* Shadows */
  --shadow-xs: 0 1px 2px rgba(15, 23, 42, 0.04);

  --shadow-sm:
    0 14px 32px -24px rgba(15, 23, 42, 0.24),
    0 5px 14px -12px rgba(15, 23, 42, 0.1);

  --shadow-md:
    0 24px 54px -34px rgba(15, 23, 42, 0.28),
    0 10px 24px -18px rgba(15, 23, 42, 0.12);

  --shadow-lg:
    0 34px 78px -42px rgba(15, 23, 42, 0.34),
    0 16px 36px -22px rgba(15, 23, 42, 0.16);

  --shadow-control: 0 12px 30px -28px rgba(15, 23, 42, 0.24);

  --shadow-control-focus:
    0 0 0 3px rgba(46, 96, 255, 0.06),
    0 18px 38px -30px rgba(46, 96, 255, 0.2);

  --shadow-button-brand: 0 14px 34px -24px rgba(46, 96, 255, 0.42);

  --shadow-button-brand-hover: 0 18px 40px -25px rgba(46, 96, 255, 0.52);

  --shadow-inset-top: inset 0 1px 0 rgba(255, 255, 255, 0.96);

  --shadow-inset-control:
    inset 0 1px 0 rgba(255, 255, 255, 0.96),
    inset 0 -1px 0 rgba(15, 23, 42, 0.025);

  --focus-ring: 0 0 0 4px rgba(46, 96, 255, 0.12);

  /* Controls */
  --control-sm: 40px;
  --control-md: 46px;
  --control-lg: 54px;
  --control-xl: 56px;

  /* Motion */
  --motion-fast: 120ms;
  --motion-base: 180ms;
  --motion-slow: 260ms;
  --motion-slower: 360ms;
  --motion-premium: cubic-bezier(0.22, 1, 0.36, 1);
  --motion-spring: cubic-bezier(0.16, 1, 0.3, 1);

  /* Layout */
  --page-max: 1280px;
  --page-wide: 1440px;
  --page-shell: 1440px;

  /* Z-index */
  --z-header: 60;
  --z-sidebar: 55;
  --z-overlay: 120;
  --z-popover: 180;
}

/* ==========================================================================
   Base reset
   ========================================================================== */

html,
body,
#root {
  min-height: 100%;
}

html {
  height: 100%;
}

body {
  margin: 0;
  min-height: 100%;
  overflow-x: hidden;
  background: rgb(var(--color-canvas));
  color: rgb(var(--color-text));
  font-family: var(--font-sans);
  font-size: 14px;
  font-weight: var(--font-weight-regular);
  line-height: var(--line-body);
  letter-spacing: var(--tracking-tight-xs);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

#root {
  min-height: 100vh;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

::selection {
  background: rgba(46, 96, 255, 0.14);
  color: rgb(var(--color-text));
}

a {
  color: inherit;
  text-decoration: none;
}

h1,
h2,
h3,
h4,
h5,
h6,
p {
  margin: 0;
}

h1,
h2,
h3,
h4,
h5,
h6 {
  color: rgb(var(--color-text));
  font-family: var(--font-display);
  font-weight: var(--font-weight-semibold);
  letter-spacing: var(--tracking-tight-xl);
}

img,
svg,
canvas,
video {
  display: block;
  max-width: 100%;
}

button,
input,
textarea,
select {
  font: inherit;
  -webkit-tap-highlight-color: transparent;
}

button {
  cursor: pointer;
}

button:disabled {
  cursor: not-allowed;
}

button,
[role="button"] {
  outline: none;
}

input,
textarea,
select {
  color: rgb(var(--color-text));
}

input::placeholder,
textarea::placeholder {
  color: rgb(var(--color-text-subtle));
  opacity: 1;
}

textarea {
  resize: vertical;
}

hr {
  margin: 0;
  border: 0;
  border-top: 1px solid rgb(var(--color-line-soft));
}

table {
  border-collapse: collapse;
  border-spacing: 0;
}

:where(button, a, input, textarea, select, [tabindex]):focus-visible {
  outline: none;
  box-shadow: var(--focus-ring);
}

::-webkit-search-decoration,
::-webkit-search-cancel-button,
::-webkit-search-results-button,
::-webkit-search-results-decoration {
  appearance: none;
}

#app-boot {
  display: none !important;
}

/* ==========================================================================
   Ant Design alignment
   ========================================================================== */

.ant-app,
.ant-app * {
  font-family: inherit;
}





.ant-dropdown .ant-dropdown-menu,
.ant-select-dropdown,
.ant-picker-dropdown .ant-picker-panel-container,
.ant-modal .ant-modal-content,
.ant-drawer .ant-drawer-content,
.ant-table-wrapper .ant-table {
  border: 1px solid rgb(var(--color-line-soft));
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-md);
}

.ant-modal-root .ant-modal-mask,
.ant-drawer-mask {
  background: rgba(var(--color-overlay), 0.28) !important;
}

.ant-tooltip .ant-tooltip-inner {
  border-radius: var(--radius-sm) !important;
  font-size: 11px !important;
  padding: 8px 10px !important;
}

.ant-skeleton.ant-skeleton-active .ant-skeleton-title,
.ant-skeleton.ant-skeleton-active .ant-skeleton-paragraph > li {
  background:
    linear-gradient(
      90deg,
      rgba(226, 232, 240, 0.55) 25%,
      rgba(241, 245, 249, 0.9) 37%,
      rgba(226, 232, 240, 0.55) 63%
    ) !important;
  background-size: 400% 100% !important;
}

/* ==========================================================================
   Scrollbars
   ========================================================================== */

.page-scroll,
.command-scroll,
.panel-scroll,
.sidebar-scroll {
  scrollbar-width: thin;
  scrollbar-color: rgba(100, 116, 139, 0.34) transparent;
  overscroll-behavior: contain;
}

.page-scroll::-webkit-scrollbar,
.command-scroll::-webkit-scrollbar,
.panel-scroll::-webkit-scrollbar,
.sidebar-scroll::-webkit-scrollbar {
  width: 10px;
  height: 10px;
}

.page-scroll::-webkit-scrollbar-track,
.command-scroll::-webkit-scrollbar-track,
.panel-scroll::-webkit-scrollbar-track,
.sidebar-scroll::-webkit-scrollbar-track {
  background: transparent;
}

.page-scroll::-webkit-scrollbar-thumb,
.command-scroll::-webkit-scrollbar-thumb,
.panel-scroll::-webkit-scrollbar-thumb,
.sidebar-scroll::-webkit-scrollbar-thumb {
  border: 3px solid transparent;
  border-radius: 999px;
  background: rgba(100, 116, 139, 0.28);
  background-clip: padding-box;
}

.page-scroll::-webkit-scrollbar-thumb:hover,
.command-scroll::-webkit-scrollbar-thumb:hover,
.panel-scroll::-webkit-scrollbar-thumb:hover,
.sidebar-scroll::-webkit-scrollbar-thumb:hover {
  background: rgba(100, 116, 139, 0.42);
  background-clip: padding-box;
}

/* ==========================================================================
   Keyframes
   ========================================================================== */

@keyframes shellFadeIn {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

.command-overlay-anim,
.command-panel-anim,
.dropdown-panel-anim {
  animation: shellFadeIn var(--motion-fast) var(--motion-premium) both;
}

/* ==========================================================================
   Core UI primitives
   ========================================================================== */

@layer components {
  .ui-radius-control-outer,
  .ui-control-radius-outer {
    border-radius: var(--ui-radius-control-outer);
  }

  .ui-radius-control-inner,
  .ui-control-radius-inner {
    border-radius: var(--ui-radius-control-inner);
  }

  .ui-radius-button {
    border-radius: var(--ui-radius-button);
  }

  .ui-radius-badge {
    border-radius: var(--ui-radius-badge);
  }

  .app-surface {
    border: 1px solid rgb(var(--color-line-soft));
    border-radius: var(--radius-lg);
    background: rgb(var(--color-surface));
    box-shadow: var(--shadow-sm);
  }

  .app-surface-muted {
    border: 1px solid rgb(var(--color-line-soft));
    border-radius: var(--radius-lg);
    background: rgb(var(--color-surface-muted));
  }

  .app-surface-subtle {
    border: 1px solid rgb(var(--color-line-soft));
    border-radius: var(--radius-lg);
    background: rgb(var(--color-surface-subtle));
  }

  .app-divider {
    height: 1px;
    width: 100%;
    background: rgb(var(--color-line-soft));
  }

  

  

  

  /* Button */
  .ui-button {
    position: relative;
    display: inline-flex;
    flex-shrink: 0;
    overflow: hidden;
    padding: 1.5px;
    border: 0;
    border-radius: var(--ui-radius-control-outer);
    outline: 0;
    transition:
      transform var(--motion-base) var(--motion-premium),
      box-shadow var(--motion-base) var(--motion-premium),
      opacity var(--motion-base) var(--motion-premium),
      background-color var(--motion-base) var(--motion-premium);
  }

  .ui-button:not(:disabled):hover {
    transform: translateY(-1px);
  }

  .ui-button:not(:disabled):active {
    transform: translateY(0);
  }

  .ui-button:disabled,
  .ui-button[aria-disabled="true"] {
    pointer-events: none;
    opacity: 0.6;
  }

  .ui-button--full {
    width: 100%;
  }

  .ui-button__inner {
    position: relative;
    display: inline-flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: var(--ui-radius-control-inner);
    font-weight: var(--font-weight-semibold);
    line-height: 1;
    letter-spacing: var(--tracking-tight-md);
    white-space: nowrap;
    transition:
      background-color var(--motion-base) var(--motion-premium),
      color var(--motion-base) var(--motion-premium),
      box-shadow var(--motion-base) var(--motion-premium);
  }

  .ui-button__icon {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
  }

  .ui-button--sm .ui-button__inner {
    height: 40px;
    padding: 0 16px;
    font-size: 13px;
  }

  .ui-button--md .ui-button__inner {
    height: 46px;
    padding: 0 20px;
    font-size: 14px;
  }

  .ui-button--lg .ui-button__inner,
  .ui-button--hero .ui-button__inner,
  .ui-button--auth .ui-button__inner {
    height: 54px;
    padding: 0 24px;
    font-size: 15px;
  }

  .ui-button--xl .ui-button__inner {
    height: 56px;
    padding: 0 24px;
    font-size: 15.5px;
  }

  .ui-button--icon .ui-button__inner {
    width: 46px;
    height: 46px;
    padding: 0;
    font-size: 14px;
  }

  .ui-button--primary {
    background: rgba(46, 96, 255, 0.28);
    box-shadow: var(--shadow-button-brand);
  }

  .ui-button--primary .ui-button__inner {
    background: rgb(var(--color-brand));
    color: #fff;
  }

  .ui-button--primary:not(:disabled):hover {
    box-shadow: var(--shadow-button-brand-hover);
  }

  .ui-button--primary:not(:disabled):hover .ui-button__inner,
  .ui-button--primary:not(:disabled):active .ui-button__inner {
    background: rgb(var(--color-brand-strong));
  }

  .ui-button--secondary,
  .ui-button--outline {
    background: rgb(var(--color-line-strong));
    box-shadow: 0 12px 28px -26px rgba(15, 23, 42, 0.18);
  }

  .ui-button--secondary .ui-button__inner,
  .ui-button--outline .ui-button__inner {
    background: rgb(var(--color-surface));
    color: rgb(var(--color-text));
  }

  .ui-button--secondary:not(:disabled):hover .ui-button__inner,
  .ui-button--outline:not(:disabled):hover .ui-button__inner {
    background: rgb(var(--color-surface-muted));
  }

  .ui-button--ghost {
    background: transparent;
    box-shadow: none;
  }

  .ui-button--ghost .ui-button__inner {
    background: transparent;
    color: rgb(var(--color-text-muted));
  }

  .ui-button--ghost:not(:disabled):hover .ui-button__inner {
    background: rgb(var(--color-surface-subtle));
    color: rgb(var(--color-text));
  }

  .ui-button--soft {
    background: rgba(var(--color-brand), 0.18);
    box-shadow: 0 12px 28px -26px rgba(46, 96, 255, 0.22);
  }

  .ui-button--soft .ui-button__inner {
    background: rgba(var(--color-brand), 0.08);
    color: rgb(var(--color-brand));
  }

  .ui-button--soft:not(:disabled):hover .ui-button__inner {
    background: rgba(var(--color-brand), 0.12);
  }

  .ui-button--danger {
    background: rgba(var(--color-danger), 0.24);
    box-shadow: 0 14px 32px -24px rgba(190, 24, 93, 0.28);
  }

  .ui-button--danger .ui-button__inner {
    background: rgb(var(--color-danger));
    color: #fff;
  }

  .ui-button--danger:not(:disabled):hover .ui-button__inner {
    background: rgba(var(--color-danger), 0.94);
  }

  /* Fields */
  .ui-field-shell {
    --field-height: 46px;
    --field-font-size: 14px;
    --field-font-weight: var(--font-weight-semibold);
    --field-tracking: -0.01em;
    --field-pad-x: 14px;
    --field-left-slot: 42px;
    --field-right-slot: 42px;
    --field-right-wide: 84px;
    --field-icon-inset: 14px;
    --field-slot-inset: 14px;
    --field-textarea-min: 124px;

    position: relative;
    width: 100%;
    overflow: hidden;
    padding: 1.5px;
    border-radius: var(--ui-radius-control-outer);
    background: rgb(var(--color-surface));
    box-shadow: var(--shadow-control);
    transition:
      box-shadow var(--motion-base) var(--motion-premium),
      opacity var(--motion-base) var(--motion-premium);
  }

  .ui-field-shell:focus-within {
    box-shadow: var(--shadow-control-focus);
  }

  .ui-field-shell[data-disabled="true"] {
    opacity: 0.75;
    box-shadow: none;
  }

  .ui-field-border {
    position: absolute;
    inset: 0;
    border-radius: var(--ui-radius-control-outer);
    background: rgb(var(--color-line));
    transition:
      background-color var(--motion-base) var(--motion-premium),
      opacity var(--motion-base) var(--motion-premium);
  }

  .ui-field-shell:hover .ui-field-border {
    background: rgb(var(--color-line-strong));
  }

  .ui-field-shell:focus-within .ui-field-border {
    background: rgba(var(--color-brand), 0.72);
  }

  .ui-field-shell[data-disabled="true"] .ui-field-border,
  .ui-field-shell[data-readonly="true"] .ui-field-border {
    background: rgb(var(--color-line-soft));
  }

  .ui-field-shell[data-invalid="true"] .ui-field-border {
    background: rgba(var(--color-danger), 0.42);
  }

  .ui-field-shell[data-invalid="true"] {
    box-shadow:
      0 0 0 3px rgba(var(--color-danger), 0.06),
      0 18px 40px -38px rgba(15, 23, 42, 0.24);
  }

  .ui-field-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: var(--ui-radius-control-inner);
    background: rgb(var(--color-surface));
  }

  .ui-field-shell[data-disabled="true"] .ui-field-inner {
    background: rgb(var(--color-surface-subtle));
  }

  .ui-field-shell[data-readonly="true"] .ui-field-inner {
    background: rgb(var(--color-surface-muted));
  }

  .ui-field-control {
    display: block;
    width: 100%;
    height: var(--field-height);
    border: 0;
    outline: 0;
    background: transparent;
    color: rgb(var(--color-text));
    font-size: var(--field-font-size);
    font-weight: var(--field-font-weight);
    letter-spacing: var(--field-tracking);
    box-shadow: none;
    appearance: none;
  }

  .ui-field-control:focus,
  .ui-field-control:focus-visible,
  .ui-field-control:focus-within {
    border: 0;
    outline: 0;
    background: transparent;
    box-shadow: none;
  }

  .ui-field-control::placeholder {
    color: rgb(var(--color-text-subtle));
    font-weight: var(--font-weight-medium);
    opacity: 1;
  }

  .ui-field-control:disabled {
    cursor: not-allowed;
  }

  .ui-input-control {
    padding-left: var(--field-pad-x);
    padding-right: var(--field-pad-x);
  }

  .ui-field-shell[data-has-left="true"] .ui-input-control {
    padding-left: var(--field-left-slot);
  }

  .ui-field-shell[data-has-right="true"] .ui-input-control {
    padding-right: var(--field-right-slot);
  }

  .ui-field-shell[data-has-wide-right="true"] .ui-input-control {
    padding-right: var(--field-right-wide);
  }

  .ui-field-icon {
    pointer-events: none;
    position: absolute;
    top: 50%;
    left: var(--field-icon-inset);
    z-index: 2;
    display: inline-flex;
    transform: translateY(-50%);
    color: rgb(var(--color-text-subtle));
    transition: color var(--motion-base) var(--motion-premium);
  }

  .ui-field-shell:focus-within .ui-field-icon {
    color: rgb(var(--color-brand));
  }

  .ui-field-right {
    position: absolute;
    top: 50%;
    right: var(--field-slot-inset);
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 6px;
    transform: translateY(-50%);
  }

  .ui-field-clear {
    display: inline-flex;
    width: 28px;
    height: 28px;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: rgb(var(--color-text-subtle));
    transition:
      background-color var(--motion-base) var(--motion-premium),
      color var(--motion-base) var(--motion-premium);
  }

  .ui-field-clear:hover {
    background: rgb(var(--color-surface-subtle));
    color: rgb(var(--color-text));
  }

  .ui-textarea-wrap {
    padding: 14px;
  }

  .ui-textarea-control {
    min-height: var(--field-textarea-min);
    height: auto;
    padding: 0;
    resize: vertical;
    line-height: 1.55;
  }

  .ui-select-wrap {
    position: relative;
    padding-left: var(--field-pad-x);
    padding-right: var(--field-pad-x);
  }

  .ui-select-control {
    padding: 0 40px 0 0;
  }

  .ui-select-chevron {
    pointer-events: none;
    position: absolute;
    top: 50%;
    right: 12px;
    z-index: 2;
    width: 16px;
    height: 16px;
    transform: translateY(-50%);
    color: rgb(var(--color-text-subtle));
    transition: color var(--motion-base) var(--motion-premium);
  }

  .ui-field-shell:focus-within .ui-select-chevron {
    color: rgb(var(--color-brand));
  }

  .ui-field--quiet {
    --field-height: 42px;
    --field-font-size: 13.5px;
    --field-tracking: -0.01em;
    --field-pad-x: 14px;
    --field-left-slot: 40px;
    --field-right-slot: 40px;
    --field-right-wide: 78px;
    --field-icon-inset: 14px;
    --field-slot-inset: 12px;
    --field-textarea-min: 112px;
  }

  .ui-field--product {
    --field-height: 48px;
    --field-font-size: 14.5px;
    --field-tracking: -0.012em;
    --field-pad-x: 16px;
    --field-left-slot: 46px;
    --field-right-slot: 46px;
    --field-right-wide: 88px;
    --field-icon-inset: 16px;
    --field-slot-inset: 14px;
    --field-textarea-min: 136px;
  }

  .ui-field--large {
    --field-height: 54px;
    --field-font-size: 15.5px;
    --field-tracking: -0.015em;
    --field-pad-x: 16px;
    --field-left-slot: 48px;
    --field-right-slot: 48px;
    --field-right-wide: 92px;
    --field-icon-inset: 16px;
    --field-slot-inset: 16px;
    --field-textarea-min: 148px;
  }

  .ui-field--large .ui-textarea-wrap {
    padding: 16px;
  }

  .ui-field--product .ui-textarea-wrap {
    padding: 14px 16px;
  }

  .ui-field--quiet .ui-textarea-wrap {
    padding: 12px 14px;
  }

  /* Card — Channel Catalog / contact card material */
  .ui-card {
    --ui-card-radius: var(--radius-xl);
    --ui-card-inner-radius: calc(var(--ui-card-radius) - 1.25px);

    position: relative;
    min-width: 0;
    border: 0;
    border-radius: var(--ui-card-radius);
    padding: 1.25px;
    background:
      linear-gradient(
        135deg,
        rgba(15, 23, 42, 0.18),
        rgba(15, 23, 42, 0.045) 42%,
        rgba(37, 99, 235, 0.22) 100%
      );
    box-shadow: 0 20px 46px -34px rgba(15, 23, 42, 0.42);
    transition:
      background var(--motion-base) var(--motion-premium),
      box-shadow var(--motion-base) var(--motion-premium),
      transform var(--motion-base) var(--motion-premium),
      opacity var(--motion-base) var(--motion-premium);
  }

  .ui-card::before {
    content: "";
    pointer-events: none;
    position: absolute;
    inset: 1.25px;
    z-index: 0;
    border-radius: var(--ui-card-inner-radius);
    background:
      linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.96),
        rgba(255, 255, 255, 0.88)
      );
    opacity: 0.92;
  }

  .ui-card__inner {
    position: relative;
    z-index: 1;
    min-width: 0;
    min-height: 100%;
    border-radius: var(--ui-card-inner-radius);
    background: rgb(var(--color-surface));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.96),
      inset 0 -1px 0 rgba(15, 23, 42, 0.025);
  }

  .ui-card__inner--clip {
    overflow: hidden;
  }

  .ui-card__inner--open {
    overflow: visible;
  }

  .ui-card--surface:hover,
  .ui-card--interactive:hover {
    background:
      linear-gradient(
        135deg,
        rgba(15, 23, 42, 0.22),
        rgba(37, 99, 235, 0.12) 44%,
        rgba(37, 99, 235, 0.32) 100%
      );
    box-shadow: 0 30px 64px -40px rgba(15, 23, 42, 0.48);
  }

  .ui-card--interactive:hover {
    transform: translateY(-1px);
  }

  .ui-card--interactive:active {
    transform: translateY(0);
  }

  .ui-card--padded-none {
    padding: 0;
  }

  .ui-card--padded-xs {
    padding: 12px;
  }

  .ui-card--padded-sm {
    padding: 16px;
  }

  .ui-card--padded-md {
    padding: 20px;
  }

  .ui-card--padded-lg {
    padding: 24px;
  }

  .ui-card--padded-xl {
    padding: 28px;
  }

  .ui-card--subtle {
    background:
      linear-gradient(
        135deg,
        rgba(148, 163, 184, 0.18),
        rgba(148, 163, 184, 0.055) 48%,
        rgba(15, 23, 42, 0.08) 100%
      );
    box-shadow: 0 14px 34px -30px rgba(15, 23, 42, 0.26);
  }

  .ui-card--subtle .ui-card__inner {
    background: rgb(var(--color-surface-muted));
  }

  .ui-card--elevated {
    background:
      linear-gradient(
        135deg,
        rgba(15, 23, 42, 0.2),
        rgba(15, 23, 42, 0.06) 42%,
        rgba(46, 96, 255, 0.26) 100%
      );
    box-shadow: 0 28px 68px -46px rgba(15, 23, 42, 0.36);
  }

  .ui-card--plain {
    padding: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  .ui-card--plain::before {
    display: none;
  }

  .ui-card--plain .ui-card__inner {
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  .ui-card--tone-brand,
  .ui-card--tone-info {
    background:
      linear-gradient(
        135deg,
        rgba(46, 96, 255, 0.24),
        rgba(46, 96, 255, 0.08) 45%,
        rgba(37, 99, 235, 0.3) 100%
      );
  }

  .ui-card--tone-success {
    background:
      linear-gradient(
        135deg,
        rgba(21, 128, 61, 0.22),
        rgba(21, 128, 61, 0.075) 45%,
        rgba(5, 150, 105, 0.24) 100%
      );
  }

  .ui-card--tone-warning {
    background:
      linear-gradient(
        135deg,
        rgba(180, 83, 9, 0.22),
        rgba(180, 83, 9, 0.075) 45%,
        rgba(217, 119, 6, 0.24) 100%
      );
  }

  .ui-card--tone-danger {
    background:
      linear-gradient(
        135deg,
        rgba(190, 24, 93, 0.2),
        rgba(190, 24, 93, 0.07) 45%,
        rgba(159, 18, 57, 0.22) 100%
      );
  }

  

  

  

  

  

  

  

  

  

  
}

/* ==========================================================================
   Utility aliases used by current components and Tailwind config
   ========================================================================== */

@layer utilities {
  .bg-canvas {
    background-color: rgb(var(--color-canvas));
  }

  .bg-canvas-muted {
    background-color: rgb(var(--color-canvas-muted));
  }

  .bg-surface {
    background-color: rgb(var(--color-surface));
  }

  .bg-surface-muted {
    background-color: rgb(var(--color-surface-muted));
  }

  .bg-surface-subtle {
    background-color: rgb(var(--color-surface-subtle));
  }

  .bg-brand {
    background-color: rgb(var(--color-brand));
  }

  .bg-brand-strong {
    background-color: rgb(var(--color-brand-strong));
  }

  .bg-brand-soft {
    background-color: rgb(var(--color-brand-soft));
  }

  .bg-info-soft {
    background-color: rgb(var(--color-info-soft));
  }

  .bg-success-soft {
    background-color: rgb(var(--color-success-soft));
  }

  .bg-warning-soft {
    background-color: rgb(var(--color-warning-soft));
  }

  .bg-danger-soft {
    background-color: rgb(var(--color-danger-soft));
  }

  .text-text {
    color: rgb(var(--color-text));
  }

  .text-text-muted {
    color: rgb(var(--color-text-muted));
  }

  .text-text-subtle {
    color: rgb(var(--color-text-subtle));
  }

  .text-brand {
    color: rgb(var(--color-brand));
  }

  .text-info {
    color: rgb(var(--color-info));
  }

  .text-success {
    color: rgb(var(--color-success));
  }

  .text-warning {
    color: rgb(var(--color-warning));
  }

  .text-danger {
    color: rgb(var(--color-danger));
  }

  .border-line {
    border-color: rgb(var(--color-line));
  }

  .border-line-strong {
    border-color: rgb(var(--color-line-strong));
  }

  .border-line-soft {
    border-color: rgb(var(--color-line-soft));
  }

  .border-brand {
    border-color: rgb(var(--color-brand));
  }

  .border-brand-strong {
    border-color: rgb(var(--color-brand-strong));
  }

  .border-success {
    border-color: rgb(var(--color-success));
  }

  .border-warning {
    border-color: rgb(var(--color-warning));
  }

  .border-danger {
    border-color: rgb(var(--color-danger));
  }

  .rounded-panel {
    border-radius: var(--radius-lg);
  }

  .rounded-soft {
    border-radius: var(--radius-md);
  }

  .rounded-pill {
    border-radius: var(--radius-pill);
  }

  .shadow-panel {
    box-shadow: var(--shadow-sm);
  }

  .shadow-panel-strong {
    box-shadow: var(--shadow-lg);
  }

  .font-display {
    font-family: var(--font-display);
  }

  .duration-fast {
    transition-duration: var(--motion-fast);
  }

  .duration-base {
    transition-duration: var(--motion-base);
  }

  .duration-slow {
    transition-duration: var(--motion-slow);
  }

  .ease-premium {
    transition-timing-function: var(--motion-premium);
  }

  .max-w-page {
    max-width: var(--page-max);
  }

  .max-w-shell-content {
    max-width: var(--page-shell);
  }

  .bg-overlay\/60 {
    background-color: rgba(var(--color-overlay), 0.6);
  }

  .bg-overlay\/72 {
    background-color: rgba(var(--color-overlay), 0.72);
  }
}

/* ==========================================================================
   Autofill
   ========================================================================== */

.ui-field-shell:has(input:-webkit-autofill),
.ui-field-shell:has(textarea:-webkit-autofill),
.ui-field-shell:has(select:-webkit-autofill) {
  background-color: rgb(var(--color-surface)) !important;
}

.ui-field-shell input:-webkit-autofill,
.ui-field-shell input:-webkit-autofill:hover,
.ui-field-shell input:-webkit-autofill:focus,
.ui-field-shell input:-webkit-autofill:active,
.ui-field-shell textarea:-webkit-autofill,
.ui-field-shell textarea:-webkit-autofill:hover,
.ui-field-shell textarea:-webkit-autofill:focus,
.ui-field-shell textarea:-webkit-autofill:active,
.ui-field-shell select:-webkit-autofill,
.ui-field-shell select:-webkit-autofill:hover,
.ui-field-shell select:-webkit-autofill:focus,
.ui-field-shell select:-webkit-autofill:active,
input:-webkit-autofill,
input:-webkit-autofill:hover,
input:-webkit-autofill:focus,
input:-webkit-autofill:active,
textarea:-webkit-autofill,
textarea:-webkit-autofill:hover,
textarea:-webkit-autofill:focus,
textarea:-webkit-autofill:active,
select:-webkit-autofill,
select:-webkit-autofill:hover,
select:-webkit-autofill:focus,
select:-webkit-autofill:active {
  -webkit-text-fill-color: rgb(var(--color-text)) !important;
  caret-color: rgb(var(--color-text)) !important;
  -webkit-box-shadow: 0 0 0 1000px rgb(var(--color-surface)) inset !important;
  box-shadow: 0 0 0 1000px rgb(var(--color-surface)) inset !important;
  background-color: rgb(var(--color-surface)) !important;
  background-image: none !important;
  background-clip: border-box !important;
  border-radius: inherit !important;
  transition:
    background-color 999999s ease-in-out 0s,
    color 999999s ease-in-out 0s !important;
}

/* ==========================================================================
   Auth compatibility
   ========================================================================== */

.auth-page {
  min-height: 100vh;
  background: #fff;
}

.auth-page input:-webkit-autofill,
.auth-page input:-webkit-autofill:hover,
.auth-page input:-webkit-autofill:focus,
.auth-page input:-webkit-autofill:active {
  -webkit-text-fill-color: #0f172a !important;
  caret-color: #0f172a !important;
  -webkit-box-shadow: 0 0 0 1000px #fff inset !important;
  box-shadow: 0 0 0 1000px #fff inset !important;
  background-color: #fff !important;
  background-image: none !important;
}

/* ==========================================================================
   Reduced motion
   ========================================================================== */

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 1ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 1ms !important;
    scroll-behavior: auto !important;
  }
}

/* Website Chat drawer compact tabs */
.website-drawer-tabs {
  min-height: 44px;
  padding-top: 6px;
  padding-bottom: 6px;
  background:
    linear-gradient(
      180deg,
      rgba(var(--color-surface), 0.98),
      rgba(var(--color-surface-muted), 0.74)
    );
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.86),
    inset 0 -1px 0 rgba(15, 23, 42, 0.045);
}

.website-drawer-tabs > div {
  display: flex;
  align-items: center;
  gap: 6px;
}

.website-drawer-tabs button {
  height: 32px !important;
  min-height: 32px !important;
  padding: 0 10px !important;
  border: 0 !important;
  border-radius: 13px !important;
  background: transparent;
  color: rgb(var(--color-text-muted));
  font-size: 12.5px !important;
  font-weight: 620 !important;
  line-height: 1 !important;
  letter-spacing: var(--tracking-tight-sm);
  box-shadow: none !important;
  transition:
    background-color var(--motion-base) var(--motion-premium),
    color var(--motion-base) var(--motion-premium),
    box-shadow var(--motion-base) var(--motion-premium);
}

.website-drawer-tabs button svg {
  width: 15px !important;
  height: 15px !important;
  stroke-width: 2.05;
}

.website-drawer-tabs button:hover {
  background: rgba(var(--color-surface-subtle), 0.9);
  color: rgb(var(--color-text));
}

.website-drawer-tabs button[data-active="true"] {
  background: rgb(var(--color-surface));
  color: rgb(var(--color-text));
  box-shadow:
    inset 0 0 0 1px rgb(var(--color-line-soft)),
    inset 0 1px 0 rgba(255, 255, 255, 0.9),
    0 10px 22px -20px rgba(15, 23, 42, 0.28) !important;
}

/* Website Chat drawer compact panels */
.website-drawer-tabs ~ div {
  padding: 14px 18px 90px !important;
}

.website-drawer-tabs ~ div
/* Website Chat drawer compact textareas */
.website-chat-textarea {
  --field-textarea-min: 0px !important;
  overflow: visible !important;
}

.website-chat-textarea .ui-field-inner {
  overflow: visible !important;
}

.website-chat-textarea .ui-textarea-wrap {
  padding: 9px 12px !important;
}

.website-chat-textarea textarea.ui-textarea-control {
  min-height: 0 !important;
  resize: vertical !important;
  overflow: auto !important;
  line-height: 1.42 !important;
}

.website-chat-textarea--two textarea.ui-textarea-control {
  min-height: 52px !important;
}

.website-chat-textarea--three textarea.ui-textarea-control {
  min-height: 72px !important;
}

/* Website Chat compact info + light snippet */
.ui-info-tip {
  cursor: help;
}

.ui-info-tip svg {
  pointer-events: none;
}

.website-drawer-tabs ~ div pre,
.website-drawer-tabs ~ div code,
.website-drawer-tabs ~ div [class*="snippet"],
.website-drawer-tabs ~ div [class*="code"] {
  background: rgb(var(--color-surface-subtle)) !important;
  color: rgb(var(--color-text-muted)) !important;
  border-color: rgb(var(--color-line-soft)) !important;
  box-shadow: none !important;
}

.website-drawer-tabs ~ div [class*="snippet"] * ,
.website-drawer-tabs ~ div [class*="code"] * {
  color: inherit !important;
}

.website-drawer-tabs ~ div .ui-card__description {
  max-width: 72ch;
}



  

  

  

  

  

  

  

  

  

/* customers-premium-detail-harmony:end */

/* customers-real-flush-top:start */

/* Customers route-un üstündə qalan app-shell padding/gap-i sıfırlayır.
   Negative margin yoxdur, header-in altına girmir. */
body:has(.customers-page-canvas) :where(main, section, div):has(> .customers-page-canvas) {
  padding-top: 0 !important;
  margin-top: 0 !important;
}

body:has(.customers-page-canvas) :where(main, section, div):has(.customers-page-canvas) {
  row-gap: 0 !important;
}

.customers-page-canvas {
  margin-top: 0 !important;
  padding-top: 0 !important;
  padding-bottom: 0 !important;
}









  

  

  

  

  

  

  

  

  

  

  

  

  






/* Customers page: force the whole canvas pure white */
.customers-page-white,
.customers-page-white table,
.customers-page-white thead,
.customers-page-white thead tr,
.customers-page-white thead th,
.customers-page-white tbody,
.customers-page-white tbody tr,
.customers-page-white tbody td,
.customers-page-white aside,
.customers-page-white section {
  background: #ffffff !important;
  background-color: #ffffff !important;
  background-image: none !important;
}

.customers-page-white button:not(:hover),
.customers-page-white input,
.customers-page-white select {
  background-color: #ffffff !important;
  background-image: none !important;
}

.customers-page-white [class*="bg-[linear-gradient"] {
  background: #ffffff !important;
  background-image: none !important;
}







































































/* CUSTOMERS_DETAIL_PANEL_DIVIDERS_RESTORE_END */

/* === AIHQ compact-radius override:start === */
/* Tighter SaaS radius: dördkünc hiss, yumşaq kənar */

/* Tailwind rounded-ləri də sərtləşdir */
.rounded-\[22px\],
.rounded-\[21px\],
.rounded-\[20px\],
.rounded-\[18px\],
.rounded-\[16px\],
.rounded-\[14px\],
.rounded-\[13px\],
.rounded-\[12px\],
.rounded-\[11px\] {
  border-radius: 7px !important;
}

.rounded-\[10px\],
.rounded-\[9px\],
.rounded-\[8px\],
.rounded-\[7px\] {
  border-radius: 6px !important;
}

.rounded-full {
  border-radius: 7px !important;
}

/* Avatar/icon dairələri dairə qalsın */
.h-8.w-8.rounded-full,
.h-9.w-9.rounded-full,
.h-10.w-10.rounded-full,
.h-11.w-11.rounded-full,
.h-12.w-12.rounded-full {
  border-radius: 9999px !important;
}
/* === AIHQ compact-radius override:end === */


/* === AIHQ sharp-radius-system:start === */
:root {
  --radius-xs: 3px;
  --radius-sm: 4px;
  --radius-md: 6px;
  --radius-lg: 8px;
  --radius-xl: 10px;
  --radius-2xl: 12px;
  --radius-3xl: 14px;

  --ui-radius-control-outer: 6px;
  --ui-radius-control-inner: 4px;
  --ui-radius-button: 6px;
  --ui-radius-badge: 5px;

  --ui-control-radius-outer: 6px;
  --ui-control-radius-inner: 4px;
}

@layer components {
  .ui-card {
    --ui-card-radius: 10px;
    --ui-card-inner-radius: 8px;
    border-radius: 10px;
  }

  .ui-card::before {
    border-radius: 8px;
  }

  .ui-card__inner {
    border-radius: 8px;
  }

  .ui-button {
    border-radius: 8px;
  }

  .ui-button__inner {
    border-radius: 6px;
  }

  .ui-field-shell,
  .ui-field-border {
    border-radius: 8px;
  }

  .ui-field-inner {
    border-radius: 6px;
  }

  .ui-field-clear {
    border-radius: 6px;
  }

  .ui-select-chevron {
    border-radius: 6px;
  }

  .team-soft-control {
    border-radius: 8px !important;
  }

  .team-filter-control {
    border-radius: 7px !important;
  }
}
/* === AIHQ sharp-radius-system:end === */


/* === AIHQ sharp-geometry-contract:start === */
:root {
  --aihq-sharp-radius-xs: 3px;
  --aihq-sharp-radius-sm: 4px;
  --aihq-sharp-radius-md: 6px;
  --aihq-sharp-radius-lg: 8px;
  --aihq-sharp-radius-max: 10px;
}

@layer components {
  .ui-card {
    --ui-card-radius: var(--aihq-sharp-radius-lg);
    --ui-card-inner-radius: var(--aihq-sharp-radius-md);
    border-radius: var(--aihq-sharp-radius-lg);
  }

  .ui-card::before,
  .ui-card__inner {
    border-radius: var(--aihq-sharp-radius-md);
  }

  .ui-button,
  .ui-field-shell,
  .ui-field-border {
    border-radius: var(--aihq-sharp-radius-md);
  }

  .ui-button__inner,
  .ui-field-inner {
    border-radius: var(--aihq-sharp-radius-sm);
  }

  .ui-field-clear,
  .ui-select-chevron,
  .ui-radius-button,
  .ui-radius-badge,
  .ui-radius-control-outer,
  .ui-control-radius-outer {
    border-radius: var(--aihq-sharp-radius-sm);
  }

  .team-soft-control {
    border-radius: var(--aihq-sharp-radius-md) !important;
  }

  .team-filter-control {
    border-radius: var(--aihq-sharp-radius-sm) !important;
  }
}

@layer utilities {
  .rounded-full,
  .rounded-3xl,
  .rounded-2xl,
  .rounded-xl,
  .rounded-lg,
  .rounded-md,
  .rounded {
    border-radius: var(--aihq-sharp-radius-md) !important;
  }

  .rounded-sm {
    border-radius: var(--aihq-sharp-radius-sm) !important;
  }

  .rounded-xs {
    border-radius: var(--aihq-sharp-radius-xs) !important;
  }

  .rounded-t-full,
  .rounded-r-full,
  .rounded-b-full,
  .rounded-l-full,
  .rounded-t-3xl,
  .rounded-r-3xl,
  .rounded-b-3xl,
  .rounded-l-3xl,
  .rounded-t-2xl,
  .rounded-r-2xl,
  .rounded-b-2xl,
  .rounded-l-2xl {
    border-radius: var(--aihq-sharp-radius-md) !important;
  }

  [class*="rounded-["] {
    border-radius: var(--aihq-sharp-radius-md) !important;
  }

  [class*="rounded-t-["],
  [class*="rounded-r-["],
  [class*="rounded-b-["],
  [class*="rounded-l-["] {
    border-radius: var(--aihq-sharp-radius-md) !important;
  }
}
/* === AIHQ sharp-geometry-contract:end === */


/* === AIHQ team-badge-language:start === */
@layer components {
  .ui-badge {
    display: inline-flex;
    min-width: 0;
    align-items: center;
    gap: 8px;
    border: 0;
    border-radius: 0;
    background: transparent;
    padding: 0;
    box-shadow: none;
    font-weight: var(--font-weight-semibold);
    line-height: 1;
    letter-spacing: var(--tracking-tight-sm);
    white-space: nowrap;
  }

  .ui-badge--sm {
    font-size: 12.5px;
  }

  .ui-badge--md {
    font-size: 13px;
  }

  .ui-badge__icon {
    display: inline-flex;
    width: auto;
    height: auto;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    color: currentColor;
  }

  .ui-badge__content {
    display: inline-flex;
    min-width: 0;
    align-items: center;
    gap: 8px;
    color: currentColor;
  }

  .ui-badge__content > span[class*="rounded-full"],
  .ui-badge__content > span[class*="rounded-"] {
    width: 6px;
    height: 6px;
    min-width: 6px;
    min-height: 6px;
    flex-shrink: 0;
    border-radius: 999px !important;
  }

  .ui-badge--brand,
  .ui-badge--info {
    color: rgb(var(--color-brand));
  }

  .ui-badge--success {
    color: rgb(var(--color-success));
  }

  .ui-badge--warning {
    color: rgb(var(--color-warning));
  }

  .ui-badge--danger {
    color: rgb(var(--color-danger));
  }

  .ui-badge--neutral {
    color: rgb(var(--color-text-muted));
  }
}
/* === AIHQ team-badge-language:end === */


/* === AIHQ page-shell-contract:start === */
:root {
  --aihq-page-x: 24px;
  --aihq-page-y: 24px;
  --aihq-page-bottom: 24px;
  --aihq-page-gap: 16px;
  --aihq-page-max: none;
}

.app-route-frame {
  width: 100%;
  max-width: none;
  margin: 0;
  padding: 0;
}

.app-page-canvas {
  width: 100% !important;
  max-width: var(--aihq-page-max) !important;
  min-width: 0;
  margin-left: 0 !important;
  margin-right: 0 !important;
  padding: var(--aihq-page-y) var(--aihq-page-x) var(--aihq-page-bottom) !important;
}

.app-page-canvas > * {
  min-width: 0;
}

.app-page-canvas > :first-child {
  margin-top: 0 !important;
}

.app-page-canvas > :last-child {
  margin-bottom: 0 !important;
}

.app-page-canvas.space-y-3 > :not([hidden]) ~ :not([hidden]),
.app-page-canvas.space-y-4 > :not([hidden]) ~ :not([hidden]),
.app-page-canvas.space-y-5 > :not([hidden]) ~ :not([hidden]) {
  margin-top: var(--aihq-page-gap) !important;
}

@media (max-width: 768px) {
  :root {
    --aihq-page-x: 16px;
    --aihq-page-y: 18px;
    --aihq-page-bottom: 18px;
    --aihq-page-gap: 14px;
  }
}
/* === AIHQ page-shell-contract:end === */


/* === AIHQ table-list-contract:start === */
:root {
  --aihq-surface-x: 24px;
  --aihq-surface-y: 20px;
  --aihq-row-height: 58px;
  --aihq-header-height: 44px;
  --aihq-section-gap: 16px;
}

/*
  Team-style table/list language:
  - same left/right internal rhythm
  - same row height feeling
  - no random oversized card/table spacing
  - no page-specific visual drift
*/
.app-page-canvas table {
  width: 100%;
  min-width: 0;
  border-collapse: collapse;
}

.app-page-canvas thead tr {
  min-height: var(--aihq-header-height);
}

.app-page-canvas tbody tr {
  min-height: var(--aihq-row-height);
}

.app-page-canvas th,
.app-page-canvas td {
  padding-left: 16px;
  padding-right: 16px;
  vertical-align: middle;
}

.app-page-canvas .ui-card {
  max-width: none;
}

.app-page-canvas .ui-card__inner {
  min-width: 0;
}

.app-page-canvas .ui-card--padded-xs {
  padding: 12px;
}

.app-page-canvas .ui-card--padded-sm {
  padding: 16px;
}

.app-page-canvas .ui-card--padded-md {
  padding: 20px;
}

.app-page-canvas .ui-card--padded-lg,
.app-page-canvas .ui-card--padded-xl {
  padding: 24px;
}

.app-page-canvas :where(section, article) {
  min-width: 0;
}

.app-page-canvas :where(h1, h2, h3, p) {
  max-width: none;
}

.app-page-canvas :where(canvas, svg, img) {
  max-width: 100%;
}

.app-page-canvas [class*="max-w-["] {
  max-width: none !important;
}

.app-page-canvas [class*="mx-auto"] {
  margin-left: 0 !important;
  margin-right: 0 !important;
}

.app-page-canvas [class*="px-6"],
.app-page-canvas [class*="px-5"] {
  padding-left: var(--aihq-surface-x);
  padding-right: var(--aihq-surface-x);
}

.app-page-canvas [class*="py-6"],
.app-page-canvas [class*="py-5"] {
  padding-top: var(--aihq-surface-y);
  padding-bottom: var(--aihq-surface-y);
}

/*
  Keep Team local controls as the strongest visual source.
*/
.team-soft-control,
.team-filter-control {
  box-shadow:
    inset 0 0 0 1px rgba(203, 213, 225, 0.86),
    inset 0 1px 0 rgba(255, 255, 255, 0.78),
    0 1px 2px rgba(15, 23, 42, 0.04);
}

@media (max-width: 768px) {
  :root {
    --aihq-surface-x: 16px;
    --aihq-surface-y: 16px;
    --aihq-row-height: 54px;
    --aihq-header-height: 42px;
  }

  .app-page-canvas th,
  .app-page-canvas td {
    padding-left: 12px;
    padding-right: 12px;
  }
}
/* === AIHQ table-list-contract:end === */


/* === AIHQ detail-panel-contract:start === */
:root {
  --aihq-detail-top-gap: 10px;
  --aihq-detail-right-gap: 10px;
  --aihq-detail-bottom-gap: 10px;
  --aihq-detail-width: 620px;
  --aihq-detail-header-h: 66px;
  --aihq-detail-x: 24px;
  --aihq-detail-y: 20px;
  --aihq-detail-gap: 16px;
}

.app-detail-overlay {
  pointer-events: auto;
}

.app-detail-backdrop {
  background: transparent !important;
}

.app-detail-panel-shell {
  max-width: var(--aihq-detail-width) !important;
  padding-top: var(--aihq-detail-top-gap);
  padding-right: var(--aihq-detail-right-gap);
  padding-bottom: var(--aihq-detail-bottom-gap);
}

.app-detail-panel-shell aside,
.app-detail-panel-shell [class*="drawer"],
.app-detail-panel-shell [class*="Drawer"] {
  overflow: hidden;
  border-left: 1px solid rgb(var(--color-line-soft));
  border-radius: var(--aihq-sharp-radius-lg, 8px);
  background: rgb(var(--color-surface));
  box-shadow:
    0 22px 70px -44px rgba(15, 23, 42, 0.42),
    inset 0 1px 0 rgba(255, 255, 255, 0.88);
}

.app-detail-panel-shell header {
  min-height: var(--aihq-detail-header-h);
  padding: var(--aihq-detail-y) var(--aihq-detail-x);
  border-bottom: 1px solid rgb(var(--color-line-soft));
  background: rgb(var(--color-surface));
}

.app-detail-panel-shell .panel-scroll,
.app-detail-panel-shell [class*="overflow-y-auto"] {
  padding: var(--aihq-detail-y) var(--aihq-detail-x);
  background: rgb(var(--color-surface-muted));
}

.app-detail-panel-shell .ui-card,
.app-detail-panel-shell .ui-card__inner {
  max-width: none;
}

.app-detail-panel-shell .ui-card__inner {
  padding: var(--aihq-detail-y) var(--aihq-detail-x);
}

.app-detail-panel-shell .ui-button,
.app-detail-panel-shell .ui-field-shell,
.app-detail-panel-shell .ui-card {
  border-radius: var(--aihq-sharp-radius-md, 6px);
}

.app-detail-panel-shell .ui-button__inner,
.app-detail-panel-shell .ui-field-inner,
.app-detail-panel-shell .ui-card__inner {
  border-radius: var(--aihq-sharp-radius-sm, 4px);
}

@media (max-width: 768px) {
  :root {
    --aihq-detail-top-gap: 0px;
    --aihq-detail-right-gap: 0px;
    --aihq-detail-bottom-gap: 0px;
    --aihq-detail-width: 100vw;
    --aihq-detail-x: 16px;
    --aihq-detail-y: 16px;
  }

  .app-detail-panel-shell {
    max-width: 100vw !important;
  }

  .app-detail-panel-shell aside,
  .app-detail-panel-shell [class*="drawer"],
  .app-detail-panel-shell [class*="Drawer"] {
    border-radius: 0;
  }
}
/* === AIHQ detail-panel-contract:end === */


/* === AIHQ modal-overlay-contract:start === */
:root {
  --aihq-modal-width: 560px;
  --aihq-modal-x: 24px;
  --aihq-modal-y: 20px;
  --aihq-modal-gap: 16px;
  --aihq-modal-header-h: 62px;
}

/*
  Modal / overlay language:
  Team-style sharp geometry, calm white surface, no pill/yumru material.
*/
.ant-modal {
  max-width: calc(100vw - 32px) !important;
}

.ant-modal .ant-modal-content {
  overflow: hidden !important;
  border: 1px solid rgb(var(--color-line-soft)) !important;
  border-radius: var(--aihq-sharp-radius-lg, 8px) !important;
  background: rgb(var(--color-surface)) !important;
  box-shadow:
    0 24px 80px -44px rgba(15, 23, 42, 0.42),
    inset 0 1px 0 rgba(255, 255, 255, 0.88) !important;
}

.ant-modal .ant-modal-header {
  min-height: var(--aihq-modal-header-h) !important;
  margin: 0 !important;
  padding: var(--aihq-modal-y) var(--aihq-modal-x) !important;
  border-bottom: 1px solid rgb(var(--color-line-soft)) !important;
  border-radius: 0 !important;
  background: rgb(var(--color-surface)) !important;
}

.ant-modal .ant-modal-title {
  color: rgb(var(--color-text)) !important;
  font-size: 16px !important;
  font-weight: var(--font-weight-semibold) !important;
  letter-spacing: var(--tracking-tight-md) !important;
}

.ant-modal .ant-modal-body {
  padding: var(--aihq-modal-y) var(--aihq-modal-x) !important;
  background: rgb(var(--color-surface-muted)) !important;
}

.ant-modal .ant-modal-footer {
  margin: 0 !important;
  padding: 14px var(--aihq-modal-x) !important;
  border-top: 1px solid rgb(var(--color-line-soft)) !important;
  background: rgb(var(--color-surface)) !important;
}

.ant-modal .ant-modal-close {
  top: 14px !important;
  right: 14px !important;
  width: 34px !important;
  height: 34px !important;
  border-radius: var(--aihq-sharp-radius-md, 6px) !important;
  color: rgb(var(--color-text-muted)) !important;
  transition:
    background-color var(--motion-base) var(--motion-premium),
    color var(--motion-base) var(--motion-premium) !important;
}

.ant-modal .ant-modal-close:hover {
  background: rgb(var(--color-surface-subtle)) !important;
  color: rgb(var(--color-text)) !important;
}

.ant-modal-root .ant-modal-mask,
.ant-drawer-mask {
  background: rgba(15, 23, 42, 0.18) !important;
  backdrop-filter: blur(2px);
}

/*
  Generic modal-like surfaces, if custom modals exist later.
*/
.app-modal,
.app-modal-panel,
[role="dialog"] {
  border-radius: var(--aihq-sharp-radius-lg, 8px);
}

[role="dialog"] .ui-card,
[role="dialog"] .ui-card__inner,
[role="dialog"] .ui-button,
[role="dialog"] .ui-field-shell {
  border-radius: var(--aihq-sharp-radius-md, 6px);
}

[role="dialog"] .ui-button__inner,
[role="dialog"] .ui-field-inner {
  border-radius: var(--aihq-sharp-radius-sm, 4px);
}

@media (max-width: 768px) {
  :root {
    --aihq-modal-x: 16px;
    --aihq-modal-y: 16px;
    --aihq-modal-header-h: 58px;
  }

  .ant-modal {
    max-width: calc(100vw - 20px) !important;
    margin: 10px auto !important;
  }
}
/* === AIHQ modal-overlay-contract:end === */


/* === AIHQ state-contract:start === */
:root {
  --aihq-state-x: 24px;
  --aihq-state-y: 20px;
  --aihq-state-icon: 38px;
  --aihq-state-gap: 14px;
}

/*
  Empty / loading / error state language:
  Team-style calm surfaces, sharp geometry, consistent spacing.
*/
.app-state {
  min-width: 0;
  border-radius: var(--aihq-sharp-radius-lg, 8px) !important;
  background: rgb(var(--color-surface)) !important;
}

.app-state-loading,
.app-empty-state,
.app-compact-state {
  padding: var(--aihq-state-y) var(--aihq-state-x) !important;
}

.app-state :where(h1, h2, h3) {
  color: rgb(var(--color-text));
  letter-spacing: var(--tracking-tight-lg);
}

.app-state :where(p, div) {
  letter-spacing: var(--tracking-tight-xs);
}

.app-empty-state {
  display: flex;
  min-height: 280px;
  align-items: center;
  justify-content: center;
}

.app-empty-state > div {
  max-width: 520px;
}

.app-empty-state span,
.app-state-loading span {
  border-radius: var(--aihq-sharp-radius-md, 6px) !important;
}

.app-state-skeleton {
  border-radius: var(--aihq-sharp-radius-md, 6px) !important;
  background:
    linear-gradient(
      90deg,
      rgba(226, 232, 240, 0.52),
      rgba(248, 250, 252, 0.95),
      rgba(226, 232, 240, 0.52)
    ) !important;
  background-size: 240% 100% !important;
}

/*
  Ant skeleton is only a loading primitive now, not its own visual language.
*/
.ant-skeleton.ant-skeleton-active .ant-skeleton-title,
.ant-skeleton.ant-skeleton-active .ant-skeleton-paragraph > li {
  border-radius: var(--aihq-sharp-radius-sm, 4px) !important;
  background:
    linear-gradient(
      90deg,
      rgba(226, 232, 240, 0.52) 25%,
      rgba(248, 250, 252, 0.95) 37%,
      rgba(226, 232, 240, 0.52) 63%
    ) !important;
  background-size: 400% 100% !important;
}

/*
  Inline notice language: same spacing everywhere, no rounded/pill look.
*/
.app-inline-notice {
  border-color: rgb(var(--color-line-soft)) !important;
  border-radius: var(--aihq-sharp-radius-lg, 8px) !important;
  background: rgb(var(--color-surface)) !important;
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.86),
    0 14px 34px -30px rgba(15, 23, 42, 0.24) !important;
}

.app-inline-notice::before {
  width: 3px !important;
}

.app-inline-notice > div {
  gap: var(--aihq-state-gap) !important;
}

.app-inline-notice span[aria-hidden="true"] {
  border-radius: var(--aihq-sharp-radius-md, 6px) !important;
}

.app-inline-notice .ui-button,
.app-inline-notice .ui-button__inner {
  border-radius: var(--aihq-sharp-radius-sm, 4px) !important;
}

@media (max-width: 768px) {
  :root {
    --aihq-state-x: 16px;
    --aihq-state-y: 16px;
    --aihq-state-icon: 34px;
    --aihq-state-gap: 12px;
  }

  .app-empty-state {
    min-height: 240px;
  }
}
/* === AIHQ state-contract:end === */


/* === AIHQ typography-contract:start === */
:root {
  --aihq-title-size: 22px;
  --aihq-title-line: 1.08;
  --aihq-section-title-size: 18px;
  --aihq-card-title-size: 15px;
  --aihq-body-size: 13.5px;
  --aihq-small-size: 12.5px;
  --aihq-label-size: 11px;
  --aihq-title-gap: 8px;
  --aihq-section-gap: 12px;
}

/*
  Typography language:
  Team-style compact, sharp, product-dashboard rhythm.
*/
.app-page-canvas {
  font-size: var(--aihq-body-size);
  letter-spacing: var(--tracking-tight-xs);
}

.app-page-header {
  min-width: 0;
  padding-bottom: 16px !important;
}

.app-page-header h1 {
  margin: 0 !important;
  color: rgb(var(--color-text));
  font-size: var(--aihq-title-size) !important;
  font-weight: var(--font-weight-semibold);
  line-height: var(--aihq-title-line);
  letter-spacing: var(--tracking-tight-lg);
}

.app-page-header p {
  margin-top: var(--aihq-title-gap) !important;
  max-width: none !important;
  color: rgb(var(--color-text-muted));
  font-size: var(--aihq-body-size) !important;
  font-weight: var(--font-weight-medium);
  line-height: 1.6;
  letter-spacing: var(--tracking-tight-sm);
}

.app-page-header [class*="uppercase"],
.app-section-header [class*="uppercase"],
.app-page-canvas .ui-card [class*="uppercase"] {
  font-size: var(--aihq-label-size) !important;
  font-weight: var(--font-weight-semibold);
  line-height: 1;
  letter-spacing: 0.08em !important;
  color: rgb(var(--color-text-subtle));
}

.app-section-header {
  min-width: 0;
  gap: var(--aihq-section-gap) !important;
}

.app-section-header h2 {
  margin: 0 !important;
  color: rgb(var(--color-text));
  font-size: var(--aihq-section-title-size) !important;
  font-weight: var(--font-weight-semibold);
  line-height: 1.16;
  letter-spacing: var(--tracking-tight-lg);
}

.app-section-header p {
  margin-top: 6px !important;
  color: rgb(var(--color-text-muted));
  font-size: var(--aihq-body-size) !important;
  font-weight: var(--font-weight-medium);
  line-height: 1.55;
  letter-spacing: var(--tracking-tight-sm);
}

.app-page-canvas .ui-card h1,
.app-page-canvas .ui-card h2,
.app-page-canvas .ui-card h3 {
  margin: 0;
  color: rgb(var(--color-text));
  font-weight: var(--font-weight-semibold);
  line-height: 1.16;
  letter-spacing: var(--tracking-tight-md);
}

.app-page-canvas .ui-card h1 {
  font-size: 18px !important;
}

.app-page-canvas .ui-card h2 {
  font-size: 16px !important;
}

.app-page-canvas .ui-card h3 {
  font-size: var(--aihq-card-title-size) !important;
}

.app-page-canvas .ui-card p {
  color: rgb(var(--color-text-muted));
  font-size: var(--aihq-body-size);
  font-weight: var(--font-weight-medium);
  line-height: 1.58;
}

.app-page-canvas .ui-card :where(label, small) {
  font-size: var(--aihq-small-size);
}

.app-page-canvas table th {
  color: rgb(var(--color-text-subtle));
  font-size: var(--aihq-label-size) !important;
  font-weight: var(--font-weight-semibold);
  letter-spacing: 0.08em !important;
  text-transform: uppercase;
}

.app-page-canvas table td {
  color: rgb(var(--color-text));
  font-size: 13px;
  font-weight: var(--font-weight-medium);
  letter-spacing: var(--tracking-tight-xs);
}

.app-page-canvas .ui-badge {
  font-size: 12.5px !important;
  font-weight: var(--font-weight-semibold);
  letter-spacing: var(--tracking-tight-sm);
}

.app-page-canvas .ui-button__inner {
  font-size: 13px;
  font-weight: var(--font-weight-semibold);
  letter-spacing: var(--tracking-tight-sm);
}

.app-page-canvas .ui-button--lg .ui-button__inner,
.app-page-canvas .ui-button--hero .ui-button__inner,
.app-page-canvas .ui-button--auth .ui-button__inner,
.app-page-canvas .ui-button--xl .ui-button__inner {
  font-size: 13.5px;
}

.app-page-canvas .ui-field-control {
  font-size: 13.5px;
  font-weight: var(--font-weight-semibold);
  letter-spacing: var(--tracking-tight-sm);
}

@media (max-width: 768px) {
  :root {
    --aihq-title-size: 20px;
    --aihq-section-title-size: 17px;
    --aihq-card-title-size: 14.5px;
    --aihq-body-size: 13px;
    --aihq-small-size: 12px;
    --aihq-label-size: 10.5px;
  }
}
/* === AIHQ typography-contract:end === */


/* === AIHQ metric-chart-contract:start === */
:root {
  --aihq-metric-h: 68px;
  --aihq-metric-x: 16px;
  --aihq-metric-y: 14px;
  --aihq-chart-h: 360px;
  --aihq-chart-x: 20px;
  --aihq-chart-y: 18px;
}

/*
  Metric / chart language:
  Team-style compact data surfaces, sharp geometry, no pill/yumru report material.
*/
.app-page-canvas .reports-premium-page {
  min-width: 0;
  background: rgb(var(--color-surface)) !important;
}

.app-page-canvas .reports-premium-page > div {
  border-color: rgb(var(--color-line-soft)) !important;
}

.app-page-canvas .reports-premium-page [class*="bg-[linear-gradient"],
.app-page-canvas .reports-premium-page [class*="bg-[radial-gradient"] {
  background: rgb(var(--color-surface)) !important;
}

.app-page-canvas .reports-premium-page [class*="rounded-full"] {
  border-radius: var(--aihq-sharp-radius-sm, 4px) !important;
}

.app-page-canvas .reports-premium-page [class*="rounded-["] {
  border-radius: var(--aihq-sharp-radius-md, 6px) !important;
}

/*
  Reports range switch becomes Team filter-button language.
*/
.app-page-canvas .reports-premium-page > div:first-of-type button,
.app-page-canvas .reports-premium-page button {
  border-radius: var(--aihq-sharp-radius-sm, 4px) !important;
}

/*
  Metric cells align with Team StatCard proportions.
*/
.app-page-canvas .reports-premium-page [class*="MetricCell"],
.app-page-canvas .reports-premium-page .metric-cell {
  min-height: var(--aihq-metric-h);
}

.app-page-canvas .reports-premium-page .grid.border-b > div[class*="px-6"][class*="py-4"] {
  min-height: var(--aihq-metric-h);
  padding: var(--aihq-metric-y) var(--aihq-metric-x) !important;
  border-color: rgb(var(--color-line-soft)) !important;
  background: rgb(var(--color-surface)) !important;
}

.app-page-canvas .reports-premium-page .grid.border-b > div[class*="px-6"][class*="py-4"] svg {
  width: 14px;
  height: 14px;
  color: rgb(var(--color-text-muted));
}

.app-page-canvas .reports-premium-page .grid.border-b > div[class*="px-6"][class*="py-4"] [class*="text-[24px]"] {
  margin-top: 6px !important;
  color: rgb(var(--color-text)) !important;
  font-size: 22px !important;
  font-weight: var(--font-weight-semibold) !important;
  line-height: 1 !important;
  letter-spacing: -0.04em !important;
}

.app-page-canvas .reports-premium-page .grid.border-b > div[class*="px-6"][class*="py-4"] [class*="text-[12px]"] {
  margin-top: 6px !important;
  color: rgb(var(--color-text-muted)) !important;
}

/*
  Chart container gets same page rhythm.
*/
.app-page-canvas .reports-premium-page .recharts-responsive-container {
  min-width: 0;
}

.app-page-canvas .reports-premium-page [class*="h-[390px]"] {
  height: var(--aihq-chart-h) !important;
  padding: var(--aihq-chart-y) var(--aihq-chart-x) !important;
  background: rgb(var(--color-surface)) !important;
}

/*
  Recharts tooltip becomes sharp Team-style data panel.
*/
.recharts-tooltip-wrapper [class*="rounded-"],
.recharts-default-tooltip {
  border-radius: var(--aihq-sharp-radius-md, 6px) !important;
  border-color: rgb(var(--color-line-soft)) !important;
  background: rgb(var(--color-surface)) !important;
  box-shadow:
    0 18px 48px -34px rgba(15, 23, 42, 0.42),
    inset 0 1px 0 rgba(255, 255, 255, 0.86) !important;
}

/*
  Breakdown bars and rails:
  no pill bars, compact rows, same line color.
*/
.app-page-canvas .reports-premium-page [class*="h-2"][class*="rounded-full"] {
  height: 6px !important;
  border-radius: var(--aihq-sharp-radius-xs, 3px) !important;
  background: rgb(var(--color-surface-subtle)) !important;
}

.app-page-canvas .reports-premium-page [class*="h-full"][class*="rounded-full"] {
  border-radius: var(--aihq-sharp-radius-xs, 3px) !important;
}

.app-page-canvas .reports-premium-page [class*="border-dashed"] {
  border-radius: var(--aihq-sharp-radius-md, 6px) !important;
  border-color: rgb(var(--color-line-soft)) !important;
  background: rgb(var(--color-surface-subtle)) !important;
}

.app-page-canvas .reports-premium-page [class*="xl:border-l"],
.app-page-canvas .reports-premium-page [class*="lg:border-r"],
.app-page-canvas .reports-premium-page [class*="border-r"],
.app-page-canvas .reports-premium-page [class*="border-b"] {
  border-color: rgb(var(--color-line-soft)) !important;
}

.app-page-canvas .reports-premium-page [class*="bg-[#FBFDFF]"],
.app-page-canvas .reports-premium-page [class*="bg-[#F8FAFC]"] {
  background: rgb(var(--color-surface-muted)) !important;
}

/*
  Small data pills in insight rail lose pill material.
*/
.app-page-canvas .reports-premium-page [class*="max-w-[132px]"][class*="truncate"] {
  border-radius: var(--aihq-sharp-radius-sm, 4px) !important;
  border-color: rgb(var(--color-line-soft)) !important;
  background: rgb(var(--color-surface)) !important;
  color: rgb(var(--color-text)) !important;
}

@media (max-width: 768px) {
  :root {
    --aihq-metric-h: 64px;
    --aihq-metric-x: 14px;
    --aihq-metric-y: 12px;
    --aihq-chart-h: 320px;
    --aihq-chart-x: 14px;
    --aihq-chart-y: 14px;
  }
}
/* === AIHQ metric-chart-contract:end === */


/* === AIHQ table-filter-contract:start === */
:root {
  --aihq-table-head-h: 42px;
  --aihq-table-filter-h: 32px;
  --aihq-table-cell-x: 16px;
  --aihq-table-head-font: 11px;
  --aihq-table-body-font: 13px;
}

/*
  Table header / filter language:
  Team.jsx header-filter rhythm everywhere.
*/
.app-page-canvas table thead,
.app-page-canvas thead {
  background: rgb(var(--color-surface)) !important;
}

.app-page-canvas table thead tr,
.app-page-canvas thead tr {
  min-height: var(--aihq-table-head-h) !important;
  border-bottom: 1px solid rgb(var(--color-line-soft)) !important;
}

.app-page-canvas table th,
.app-page-canvas thead th {
  height: var(--aihq-table-head-h) !important;
  padding: 0 var(--aihq-table-cell-x) !important;
  background: rgb(var(--color-surface)) !important;
  color: rgb(var(--color-text-subtle)) !important;
  font-size: var(--aihq-table-head-font) !important;
  font-weight: var(--font-weight-semibold) !important;
  line-height: 1 !important;
  letter-spacing: 0.08em !important;
  text-transform: uppercase !important;
  vertical-align: middle !important;
}

.app-page-canvas table td,
.app-page-canvas tbody td {
  padding-left: var(--aihq-table-cell-x) !important;
  padding-right: var(--aihq-table-cell-x) !important;
  color: rgb(var(--color-text)) !important;
  font-size: var(--aihq-table-body-font) !important;
  font-weight: var(--font-weight-medium) !important;
  letter-spacing: var(--tracking-tight-xs) !important;
}

/*
  Any filter/action button inside table header becomes Team HeaderFilter style.
*/
.app-page-canvas thead button,
.app-page-canvas table th button {
  min-height: var(--aihq-table-filter-h) !important;
  border-radius: var(--aihq-sharp-radius-sm, 4px) !important;
  border: 0 !important;
  background: transparent !important;
  color: rgb(var(--color-text-subtle)) !important;
  box-shadow: none !important;
  font-size: var(--aihq-table-head-font) !important;
  font-weight: var(--font-weight-semibold) !important;
  letter-spacing: 0.08em !important;
  text-transform: uppercase !important;
  transition:
    background-color var(--motion-base) var(--motion-premium),
    color var(--motion-base) var(--motion-premium) !important;
}

.app-page-canvas thead button:hover,
.app-page-canvas table th button:hover,
.app-page-canvas thead button[aria-expanded="true"],
.app-page-canvas table th button[aria-expanded="true"] {
  background: rgb(var(--color-surface-subtle)) !important;
  color: rgb(var(--color-text)) !important;
}

/*
  Header filter native inputs/select/date become Team filter-control language.
*/
.app-page-canvas thead input,
.app-page-canvas thead select,
.app-page-canvas table th input,
.app-page-canvas table th select,
.app-page-canvas [class*="filter"] input,
.app-page-canvas [class*="Filter"] input,
.app-page-canvas [class*="filter"] select,
.app-page-canvas [class*="Filter"] select {
  height: var(--aihq-table-filter-h) !important;
  min-height: var(--aihq-table-filter-h) !important;
  border: 0 !important;
  border-radius: var(--aihq-sharp-radius-sm, 4px) !important;
  background: rgb(var(--color-surface)) !important;
  box-shadow:
    inset 0 0 0 1px rgba(203, 213, 225, 0.86),
    inset 0 1px 0 rgba(255, 255, 255, 0.78),
    0 1px 2px rgba(15, 23, 42, 0.04) !important;
  color: rgb(var(--color-text)) !important;
  font-size: 12.5px !important;
  font-weight: var(--font-weight-semibold) !important;
  letter-spacing: var(--tracking-tight-sm) !important;
  outline: 0 !important;
}

.app-page-canvas thead input:focus,
.app-page-canvas thead select:focus,
.app-page-canvas table th input:focus,
.app-page-canvas table th select:focus,
.app-page-canvas [class*="filter"] input:focus,
.app-page-canvas [class*="Filter"] input:focus,
.app-page-canvas [class*="filter"] select:focus,
.app-page-canvas [class*="Filter"] select:focus {
  box-shadow:
    inset 0 0 0 1px rgba(var(--color-brand), 0.42),
    inset 0 1px 0 rgba(255, 255, 255, 0.86),
    0 0 0 3px rgba(var(--color-brand), 0.06) !important;
}

.app-page-canvas thead input::placeholder,
.app-page-canvas table th input::placeholder,
.app-page-canvas [class*="filter"] input::placeholder,
.app-page-canvas [class*="Filter"] input::placeholder {
  color: rgb(var(--color-text-subtle)) !important;
  opacity: 1 !important;
}

/*
  Dropdown/filter menus align with Team filter menu shell.
*/
.app-page-canvas [class*="dropdown"],
.app-page-canvas [class*="Dropdown"],
.app-page-canvas [class*="popover"],
.app-page-canvas [class*="Popover"],
.app-page-canvas [role="menu"],
.app-page-canvas [role="listbox"] {
  border-color: rgb(var(--color-line-soft)) !important;
  border-radius: var(--aihq-sharp-radius-md, 6px) !important;
  background: rgb(var(--color-surface)) !important;
  box-shadow:
    0 18px 45px -34px rgba(15, 23, 42, 0.65),
    inset 0 1px 0 rgba(255, 255, 255, 0.86) !important;
}

/*
  Menu items / filter options use Team compact option rhythm.
*/
.app-page-canvas [role="menuitem"],
.app-page-canvas [role="option"] {
  min-height: 32px !important;
  border-radius: var(--aihq-sharp-radius-sm, 4px) !important;
  font-size: 12.5px !important;
  font-weight: var(--font-weight-semibold) !important;
}

/*
  Keep explicit Team controls as source of truth.
*/
.team-filter-control {
  height: var(--aihq-table-filter-h) !important;
  border-radius: var(--aihq-sharp-radius-sm, 4px) !important;
  background: rgb(var(--color-surface)) !important;
}

@media (max-width: 768px) {
  :root {
    --aihq-table-head-h: 40px;
    --aihq-table-filter-h: 30px;
    --aihq-table-cell-x: 12px;
    --aihq-table-head-font: 10.5px;
    --aihq-table-body-font: 12.5px;
  }
}
/* === AIHQ table-filter-contract:end === */


/* === AIHQ toolbar-action-contract:start === */
:root {
  --aihq-toolbar-h: 40px;
  --aihq-toolbar-button-h: 34px;
  --aihq-toolbar-gap: 8px;
  --aihq-toolbar-x: 12px;
}

/*
  Toolbar / action row language:
  Team-style compact action rhythm for page headers, section headers, filter bars.
*/
.app-page-header > div:last-child,
.app-section-header > div:last-child,
.app-page-canvas [class*="toolbar"],
.app-page-canvas [class*="Toolbar"],
.app-page-canvas [class*="actions"],
.app-page-canvas [class*="Actions"] {
  min-height: var(--aihq-toolbar-h);
  align-items: center !important;
  gap: var(--aihq-toolbar-gap) !important;
}

/*
  Header/toolbar buttons are compact, not hero-sized.
*/
.app-page-header .ui-button,
.app-section-header .ui-button,
.app-page-canvas [class*="toolbar"] .ui-button,
.app-page-canvas [class*="Toolbar"] .ui-button,
.app-page-canvas [class*="actions"] .ui-button,
.app-page-canvas [class*="Actions"] .ui-button {
  border-radius: var(--aihq-sharp-radius-md, 6px) !important;
  box-shadow:
    0 10px 24px -22px rgba(15, 23, 42, 0.18) !important;
}

.app-page-header .ui-button__inner,
.app-section-header .ui-button__inner,
.app-page-canvas [class*="toolbar"] .ui-button__inner,
.app-page-canvas [class*="Toolbar"] .ui-button__inner,
.app-page-canvas [class*="actions"] .ui-button__inner,
.app-page-canvas [class*="Actions"] .ui-button__inner {
  height: var(--aihq-toolbar-button-h) !important;
  min-height: var(--aihq-toolbar-button-h) !important;
  padding-left: var(--aihq-toolbar-x) !important;
  padding-right: var(--aihq-toolbar-x) !important;
  border-radius: var(--aihq-sharp-radius-sm, 4px) !important;
  font-size: 12.5px !important;
  font-weight: var(--font-weight-semibold) !important;
  letter-spacing: var(--tracking-tight-sm) !important;
}

/*
  Icon-only actions inside toolbars match Team IconButton proportions.
*/
.app-page-header .ui-button--icon .ui-button__inner,
.app-section-header .ui-button--icon .ui-button__inner,
.app-page-canvas [class*="toolbar"] .ui-button--icon .ui-button__inner,
.app-page-canvas [class*="Toolbar"] .ui-button--icon .ui-button__inner,
.app-page-canvas [class*="actions"] .ui-button--icon .ui-button__inner,
.app-page-canvas [class*="Actions"] .ui-button--icon .ui-button__inner {
  width: var(--aihq-toolbar-button-h) !important;
  padding-left: 0 !important;
  padding-right: 0 !important;
}

/*
  Native/custom toolbar buttons that are not Button.jsx still get Team-like action material.
*/
.app-page-canvas [class*="toolbar"] button:not(.ui-button),
.app-page-canvas [class*="Toolbar"] button:not(.ui-button),
.app-page-canvas [class*="actions"] button:not(.ui-button),
.app-page-canvas [class*="Actions"] button:not(.ui-button),
.app-page-header button:not(.ui-button),
.app-section-header button:not(.ui-button) {
  min-height: var(--aihq-toolbar-button-h) !important;
  border-radius: var(--aihq-sharp-radius-sm, 4px) !important;
  font-size: 12.5px !important;
  font-weight: var(--font-weight-semibold) !important;
  letter-spacing: var(--tracking-tight-sm) !important;
}

/*
  Toolbar inputs/search boxes keep Team soft control proportions.
*/
.app-page-canvas [class*="toolbar"] input,
.app-page-canvas [class*="Toolbar"] input,
.app-page-canvas [class*="actions"] input,
.app-page-canvas [class*="Actions"] input {
  height: var(--aihq-toolbar-button-h) !important;
  min-height: var(--aihq-toolbar-button-h) !important;
  border-radius: var(--aihq-sharp-radius-sm, 4px) !important;
  font-size: 12.5px !important;
  font-weight: var(--font-weight-semibold) !important;
}

/*
  Segmented controls/range switches lose pill look.
*/
.app-page-canvas [class*="rounded-full"] button,
.app-page-canvas [class*="rounded-full"] .ui-button,
.app-page-canvas [class*="rounded-full"] .ui-button__inner {
  border-radius: var(--aihq-sharp-radius-sm, 4px) !important;
}

.app-page-canvas [class*="rounded-full"] {
  border-radius: var(--aihq-sharp-radius-md, 6px) !important;
}

/*
  Keep Team action buttons as the strongest local source.
*/
.team-soft-control,
.team-filter-control {
  border-radius: var(--aihq-sharp-radius-sm, 4px) !important;
}

@media (max-width: 768px) {
  :root {
    --aihq-toolbar-h: 38px;
    --aihq-toolbar-button-h: 32px;
    --aihq-toolbar-gap: 6px;
    --aihq-toolbar-x: 10px;
  }

  .app-page-header > div:last-child,
  .app-section-header > div:last-child {
    width: 100%;
    justify-content: flex-start !important;
  }
}
/* === AIHQ toolbar-action-contract:end === */


/* === AIHQ team-filter-input-fix:start === */
/*
  Fix: Team filter/soft controls are wrapper-based.
  The inner native input must stay transparent.
  Otherwise the global table-filter contract creates input-inside-input.
*/
.team-filter-control input,
.team-soft-control input {
  height: 100% !important;
  min-height: 0 !important;
  border: 0 !important;
  border-radius: 0 !important;
  background: transparent !important;
  box-shadow: none !important;
  outline: 0 !important;
  padding: 0 !important;
  color: rgb(var(--color-text)) !important;
  font-size: 12.5px !important;
  font-weight: var(--font-weight-semibold) !important;
  letter-spacing: var(--tracking-tight-sm) !important;
}

.team-soft-control input {
  font-size: 13.5px !important;
}

.team-filter-control input:focus,
.team-filter-control input:focus-visible,
.team-soft-control input:focus,
.team-soft-control input:focus-visible {
  border: 0 !important;
  background: transparent !important;
  box-shadow: none !important;
  outline: 0 !important;
  ring: 0 !important;
}

.team-filter-control input::placeholder,
.team-soft-control input::placeholder {
  color: rgb(var(--color-text-subtle)) !important;
  opacity: 1 !important;
}

.team-filter-control {
  overflow: hidden;
  border-radius: var(--aihq-sharp-radius-sm, 4px) !important;
}

.team-soft-control {
  overflow: hidden;
  border-radius: var(--aihq-sharp-radius-md, 6px) !important;
}
/* === AIHQ team-filter-input-fix:end === */

