function s(value, fallback = "") {
  return String(value ?? fallback).trim() || fallback;
}

function lower(value, fallback = "") {
  return s(value, fallback).toLowerCase();
}

function titleize(value = "") {
  return s(value || "unknown")
    .replace(/[_-]+/g, " ")
    .replace(/\b\w/g, (char) => char.toUpperCase());
}

function statusTone(status = "") {
  const safe = lower(status);

  if (safe === "ready") return "success";
  if (safe === "review") return "warning";
  if (safe === "blocked") return "danger";

  return "neutral";
}

function statusLabel(status = "") {
  const safe = lower(status);

  if (safe === "review") return "Needs review";
  return titleize(safe);
}

function stageStatus(stage = {}) {
  const checks = Array.isArray(stage.checks) ? stage.checks : [];

  if (checks.some((check) => lower(check.status) === "blocked")) return "blocked";
  if (checks.some((check) => lower(check.status) === "review")) return "review";

  return "ready";
}

function stageSummary(stage = {}) {
  const checks = Array.isArray(stage.checks) ? stage.checks : [];
  const ready = checks.filter((check) => lower(check.status) === "ready").length;

  return `${ready}/${checks.length} ready`;
}

function CheckItem({ check }) {
  const Icon = check.icon || CheckCircle2;
  const status = lower(check.status);

  return (
    <div className="grid gap-3 rounded-md border border-line-soft bg-white p-4 md:grid-cols-[36px_minmax(0,1fr)_116px] md:items-center">
      <div
        className={cx(
          "flex h-9 w-9 items-center justify-center rounded-md border",
          status === "ready"
            ? "border-success/20 bg-success/5 text-success"
            : status === "blocked"
              ? "border-danger/20 bg-danger/5 text-danger"
              : "border-warning/25 bg-warning/5 text-warning"
        )}
      >
        <Icon className="h-4.5 w-4.5" strokeWidth={2.05} />
      </div>

      <div className="min-w-0">
        <div className="truncate text-[13.5px] font-semibold text-text">
          {check.title}
        </div>
        <div className="mt-0.5 text-[12.5px] font-medium leading-5 text-text-muted">
          {check.description}
        </div>
      </div>

      <div className="md:text-right">
        <AppTag tone={statusTone(check.status)} dot>
          {statusLabel(check.status)}
        </AppTag>
      </div>
    </div>
  );
}

function ReadinessDots({ checks = [] }) {
  return (
    <div className="flex items-center gap-1.5">
      {checks.map((check) => (
        <span
          key={check.id}
          className={cx(
            "h-2.5 w-2.5 rounded-full border",
            lower(check.status) === "ready"
              ? "border-success bg-success"
              : lower(check.status) === "blocked"
                ? "border-danger bg-danger"
                : "border-warning bg-warning"
          )}
        />
      ))}
    </div>
  );
}

function TimelineRail({ number, status, last = false }) {
  const safeStatus = lower(status);

  return (
    <div className="relative flex w-[84px] shrink-0 flex-col items-center">
      <div
        className={cx(
          "relative z-10 flex h-16 w-16 items-center justify-center rounded-md border bg-white text-[28px] font-semibold tracking-[var(--tracking-tight-xl)] shadow-[0_14px_30px_-28px_rgba(15,23,42,0.55)]",
          safeStatus === "ready"
            ? "border-success/30 text-success"
            : safeStatus === "blocked"
              ? "border-danger/30 text-danger"
              : "border-warning/35 text-warning"
        )}
      >
        {number}
      </div>

      {!last ? (
        <div className="my-3 flex flex-1 flex-col items-center gap-2">
          {Array.from({ length: 6 }).map((_, index) => (
            <span
              // eslint-disable-next-line react/no-array-index-key
              key={index}
              className={cx(
                "h-1.5 w-1.5 rounded-full",
                safeStatus === "ready" ? "bg-success" : "bg-line"
              )}
            />
          ))}
        </div>
      ) : null}
    </div>
  );
}

function LaunchStageCard({ stage }) {
  const navigate = useNavigate();
  const Icon = stage.icon || Rocket;
  const status = stageStatus(stage);

  return (
    <Card padded={false} clip className="min-w-0 flex-1">
      <div className="grid gap-5 border-b border-line-soft p-5 xl:grid-cols-[minmax(0,1fr)_190px] xl:items-center">
        <div className="flex min-w-0 items-start gap-5">
          <div className="flex h-14 w-14 shrink-0 items-center justify-center text-text">
            <Icon className="h-9 w-9" strokeWidth={1.85} />
          </div>

          <div className="min-w-0">
            <div className="flex flex-wrap items-center gap-2">
              <h2 className="text-[22px] font-semibold tracking-[var(--tracking-tight-xl)] text-text">
                {stage.title}
              </h2>

              <AppTag tone={statusTone(status)} dot>
                {statusLabel(status)}
              </AppTag>
            </div>

            <p className="mt-1.5 max-w-[760px] text-[13.5px] font-medium leading-6 text-text-muted">
              {stage.subtitle}
            </p>

            <div className="mt-4 flex flex-wrap items-center gap-3">
              <ReadinessDots checks={stage.checks} />

              <span className="text-[12.5px] font-semibold text-text-muted">
                {stageSummary(stage)}
              </span>
            </div>
          </div>
        </div>

        <div className="xl:text-right">
          <Button
            type="button"
            size="md"
            variant={status === "blocked" ? "primary" : "secondary"}
            onClick={() => navigate(stage.path)}
            rightIcon={<ArrowRight className="h-4 w-4" strokeWidth={2.1} />}
          >
            {stage.action}
          </Button>
        </div>
      </div>

      <div className="grid gap-3 bg-surface-subtle p-4">
        {stage.checks.map((check) => (
          <CheckItem key={check.id} check={check} />
        ))}
      </div>
    </Card>
  );
}

function LaunchStage({ stage, last }) {
  const status = stageStatus(stage);

  return (
    <div className="flex items-stretch gap-4">
      <TimelineRail number={stage.number} status={status} last={last} />
      <LaunchStageCard stage={stage} />
    </div>
  );
}

export default function LaunchChecklist() {
  const summary = useMemo(() => {
    const stages = LAUNCH_STAGES.map((stage) => stageStatus(stage));
    const ready = stages.filter((status) => status === "ready").length;
    const review = stages.filter((status) => status === "review").length;
    const blocked = stages.filter((status) => status === "blocked").length;

    return { ready, review, blocked, total: stages.length };
  }, []);

  return (
    <PageCanvas>
      <PageHeader
        title="Launch path"
        description="Follow the workspace from foundation to production launch. Each stage connects to the next as it becomes ready."
      />

      <Card padded={false} clip>
        <div className="grid gap-4 p-5 lg:grid-cols-[minmax(0,1fr)_280px] lg:items-center">
          <div>
            <div className="text-[17px] font-semibold tracking-[var(--tracking-tight-md)] text-text">
              Production readiness timeline
            </div>
            <div className="mt-1 text-[13.5px] font-medium leading-6 text-text-muted">
              Complete the blocked and review stages before opening the workspace to real customer traffic.
            </div>
          </div>

          <div className="flex flex-wrap gap-2 lg:justify-end">
            <AppTag tone="success" dot>
              {summary.ready} ready
            </AppTag>
            <AppTag tone="warning" dot>
              {summary.review} review
            </AppTag>
            <AppTag tone="danger" dot>
              {summary.blocked} blocked
            </AppTag>
          </div>
        </div>
      </Card>

      <div className="grid gap-4">
        {LAUNCH_STAGES.map((stage, index) => (
          <LaunchStage
            key={stage.id}
            stage={stage}
            last={index === LAUNCH_STAGES.length - 1}
          />
        ))}
      </div>
    </PageCanvas>
  );
}
