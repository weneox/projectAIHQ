function SimpleBarChart({
  data = [],
  dataKey = "value",
  emptyTitle,
  emptyDescription,
  height = 220,
}) {
  const hasValue = data.some((item) => n(item?.[dataKey]) > 0);

  if (!hasValue) {
    return <EmptyChart title={emptyTitle} description={emptyDescription} />;
  }

  return (
    <div style={{ height }}>
      <ResponsiveContainer width="100%" height="100%">
        <BarChart data={data} margin={{ top: 8, right: 8, bottom: 0, left: -18 }}>
          <CartesianGrid strokeDasharray="3 3" vertical={false} stroke="rgba(148,163,184,0.24)" />
          <XAxis
            dataKey="label"
            axisLine={false}
            tickLine={false}
            tick={{ fontSize: 11, fill: "rgb(var(--color-text-subtle))" }}
          />
          <YAxis
            allowDecimals={false}
            axisLine={false}
            tickLine={false}
            tick={{ fontSize: 11, fill: "rgb(var(--color-text-subtle))" }}
          />
          <Tooltip cursor={{ fill: "rgba(46,96,255,0.045)" }} content={<ChartTooltip />} />
          <Bar
            dataKey={dataKey}
            name="Count"
            fill="rgb(var(--color-brand))"
            radius={[10, 10, 10, 10]}
            maxBarSize={52}
          />
        </BarChart>
      </ResponsiveContainer>
    </div>
  );
}

