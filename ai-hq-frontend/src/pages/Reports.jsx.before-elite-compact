export default function Reports() {
  const navigate = useNavigate();
  const [state, setState] = useState({
    loading: true,
    refreshing: false,
    error: "",
    posture: null,
    leads: [],
    leadsDegraded: false,
  });

  const load = useCallback(async ({ refreshing = false } = {}) => {
    setState((current) => ({
      ...current,
      loading: !refreshing,
      refreshing,
      error: "",
    }));

    try {
      const [posture, leadsPayload] = await Promise.all([
        getLaunchPosture(),
        listLeads({ limit: 200 }).catch((error) => ({
          ok: false,
          leads: [],
          degraded: true,
          error: s(error?.message),
        })),
      ]);

      setState({
        loading: false,
        refreshing: false,
        error: "",
        posture,
        leads: arr(leadsPayload?.leads),
        leadsDegraded: leadsPayload?.degraded === true,
      });
    } catch (error) {
      setState({
        loading: false,
        refreshing: false,
        error:
          s(error?.payload?.error || error?.payload?.message || error?.message) ||
          "Reports could not be loaded.",
        posture: null,
        leads: [],
        leadsDegraded: false,
      });
    }
  }, []);

  useEffect(() => {
    const timer = window.setTimeout(() => {
      void load();
    }, 0);

    return () => window.clearTimeout(timer);
  }, [load]);

  const model = useMemo(() => {
    const posture = obj(state.posture);
    const channelMap = obj(posture.channels);
    const channelSummary = obj(posture.channelSummary);
    const inbox = obj(posture.inbox);
    const leads = arr(state.leads);

    const channels = CHANNEL_IDS.map((id) => {
      const source = obj(channelMap[id]);
      const available = source.available !== false;
      const connected = source.connected === true;
      const deliveryReady = source.deliveryReady === true;

      return {
        id,
        label: channelLabel(id),
        available,
        connected,
        deliveryReady,
        tone: channelTone({ available, connected, deliveryReady }),
        status: s(source.status),
      };
    });

    const readyChannels = Math.max(
      n(channelSummary.readyCount),
      channels.filter((channel) => channel.deliveryReady).length
    );
    const connectedChannels = Math.max(
      n(channelSummary.connectedCount),
      channels.filter((channel) => channel.connected).length
    );
    const availableChannels = Math.max(
      1,
      channels.filter((channel) => channel.available).length
    );

    const inboxOpen = n(inbox.openCount);
    const inboxUnread = n(inbox.unreadCount);
    const handoff = n(inbox.handoffCount);
    const pendingOutbound = n(inbox.pendingOutboundCount);
    const failedOutbound = n(inbox.failedOutboundCount);
    const retryingOutbound = n(inbox.retryingOutboundCount);
    const outboundPressure = pendingOutbound + failedOutbound + retryingOutbound;

    const truthReady = posture.truth?.ready === true;
    const runtimeReady = posture.runtime?.ready === true;
    const channelReady = readyChannels > 0;
    const inboxAvailable = inbox.available !== false;
    const launchReady = posture.overall?.launchReady === true;

    const leadBuckets = [
      {
        label: "New",
        value: leads.filter((lead) => ["", "new"].includes(leadStage(lead))).length,
      },
      {
        label: "Qualified",
        value: leads.filter((lead) =>
          ["qualified", "proposal", "negotiation"].includes(leadStage(lead))
        ).length,
      },
      {
        label: "Won",
        value: leads.filter((lead) =>
          ["won", "converted", "customer"].includes(leadStage(lead))
        ).length,
      },
      {
        label: "Lost",
        value: leads.filter((lead) =>
          ["lost", "closed_lost"].includes(leadStage(lead))
        ).length,
      },
    ];

    const openLeads = leads.filter((lead) =>
      ["open", "new", "active"].includes(leadStatus(lead))
    ).length;

    return {
      metrics: {
        launchReady,
        truthReady,
        runtimeReady,
        channelReady,
        inboxAvailable,
        readyChannels,
        connectedChannels,
        availableChannels,
        inboxOpen,
        inboxUnread,
        handoff,
        pendingOutbound,
        failedOutbound,
        retryingOutbound,
        outboundPressure,
        leadsTotal: leads.length,
        openLeads,
      },
      channels,
      channelBars: channels.map((channel) => ({
        label: channel.label,
        live: channel.deliveryReady ? 1 : 0,
        review: channel.connected && !channel.deliveryReady ? 1 : 0,
        off: !channel.connected ? 1 : 0,
      })),
      inboxBars: [
        { label: "Open", value: inboxOpen },
        { label: "Unread", value: inboxUnread },
        { label: "Handoff", value: handoff },
        { label: "Outbound", value: outboundPressure },
      ],
      leadBuckets,
    };
  }, [state.posture, state.leads]);

  function handleNavigate(path = "") {
    if (!path) return;
    navigate(path);
  }

  if (state.loading) {
    return (
      <PageCanvas className="max-w-[1320px] py-2">
        <LoadingSurface title="Loading reports" />
      </PageCanvas>
    );
  }

  return (
    <PageCanvas className="max-w-[1320px] space-y-4 py-2">
      {state.error ? (
        <InlineNotice
          tone="danger"
          title="Reports unavailable"
          description={state.error}
          compact
        />
      ) : null}

      {state.leadsDegraded ? (
        <InlineNotice
          tone="warning"
          title="Customer analytics degraded"
          description="Lead/customer schema is unavailable in this environment, so customer charts only show available data."
          compact
        />
      ) : null}

      <SnapshotHeader
        metrics={model.metrics}
        refreshing={state.refreshing}
        onRefresh={() => load({ refreshing: true })}
      />

      <div className="grid gap-3 md:grid-cols-2 xl:grid-cols-4">
        <MetricCard
          label="Conversations"
          value={model.metrics.inboxOpen}
          detail={`${model.metrics.inboxUnread} unread Â· ${model.metrics.handoff} handoff`}
          icon={Inbox}
          tone={model.metrics.inboxUnread > 0 ? "warning" : "brand"}
        />

        <MetricCard
          label="Customers"
          value={model.metrics.leadsTotal}
          detail={`${model.metrics.openLeads} open records`}
          icon={Users}
          tone={model.metrics.leadsTotal > 0 ? "brand" : "neutral"}
        />

        <MetricCard
          label="Channels"
          value={`${model.metrics.readyChannels}/${model.metrics.availableChannels}`}
          detail={`${model.metrics.connectedChannels} connected`}
          icon={Network}
          tone={model.metrics.channelReady ? "success" : "warning"}
        />

        <MetricCard
          label="AI Guard"
          value={model.metrics.truthReady && model.metrics.runtimeReady ? "Ready" : "Guarded"}
          detail={model.metrics.outboundPressure ? `${model.metrics.outboundPressure} outbound actions` : "Manual-first control"}
          icon={Bot}
          tone={model.metrics.truthReady && model.metrics.runtimeReady ? "success" : "warning"}
        />
      </div>

      <div className="grid gap-4 xl:grid-cols-[minmax(0,1fr)_420px]">
        <div className="space-y-4">
          <div className="grid gap-4 xl:grid-cols-[0.9fr_1.1fr]">
            <ChartCard eyebrow="Channels" title="Readiness matrix">
              <ChannelReadinessMatrix channels={model.channels} />
            </ChartCard>

            <ChartCard eyebrow="Inbox" title="Conversation pressure">
              <SimpleBarChart
                data={model.inboxBars}
                emptyTitle="Inbox is calm"
                emptyDescription="Open, unread, handoff, and outbound pressure are currently zero."
              />
            </ChartCard>
          </div>

          <ChartCard eyebrow="Customers" title="Lead funnel">
            <SimpleBarChart
              data={model.leadBuckets}
              emptyTitle="No customer funnel yet"
              emptyDescription="Lead stages will appear when customer records are created from conversations."
            />
          </ChartCard>

          <ChannelTable channels={model.channels} />
        </div>

        <div className="space-y-4">
          <ExecutiveSummary metrics={model.metrics} />
          <GuardrailPanel metrics={model.metrics} onNavigate={handleNavigate} />
          <ShortcutPanel onNavigate={handleNavigate} />
        </div>
      </div>
    </PageCanvas>
  );
}