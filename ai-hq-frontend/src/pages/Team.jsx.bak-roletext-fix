        <div className="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-line bg-surface-subtle text-[11px] font-semibold text-text">
          {userInitials(user)}
        </div>

        <div className="min-w-0">
          <div className="truncate text-[13.5px] font-semibold tracking-[var(--tracking-tight-sm)] text-text">
            {userName(user)}
          </div>
        </div>
      </div>

      <div className="min-w-0">
        <div className="truncate text-[12.5px] font-medium text-text-muted">
          {email || "No email"}
        </div>
      </div>

      <div className="min-w-0">
        <RoleText role={role} />
      </div>

      <div className="min-w-0">
        <StatusText tone={toneForStatus(status)}>{titleize(status)}</StatusText>
      </div>

      <div className="min-w-0">
        <div className="truncate text-[12px] font-semibold text-text-muted">
          {id || "—"}
        </div>
      </div>

      <div className="text-[12px] font-medium text-text-subtle">
        {updated || "—"}
      </div>

      <div className="flex w-[124px] items-center justify-end gap-2">
        {canManage && !owner ? (
          <CompactActionButton
            loading={busy}
            disabled={!id || busy}
            onClick={() => onToggleStatus(user)}
          >
            {active ? "Disable" : "Activate"}
          </CompactActionButton>
        ) : (
          <CompactActionButton disabled muted>
            Owner
          </CompactActionButton>
        )}

        <IconButton
          disabled={!canManage || !id}
          onClick={() => onEdit(user)}
          label="Edit member"
        >
          <Pencil className="h-3.5 w-3.5" strokeWidth={2.1} />
        </IconButton>
      </div>
    </div>
  );
}
