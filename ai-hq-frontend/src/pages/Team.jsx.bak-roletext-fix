    user.updated_at || user.updatedAt || user.created_at || user.createdAt
  );

  return (
    <div className="grid min-h-[62px] min-w-[1120px] grid-cols-[minmax(180px,0.95fr)_minmax(220px,1.05fr)_108px_108px_minmax(150px,0.75fr)_88px_124px] items-center gap-3 px-4 transition-colors duration-base ease-premium hover:bg-surface-subtle/55">
