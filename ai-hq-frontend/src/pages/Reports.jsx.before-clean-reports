function BarMeter({ label, value, total, tone = "brand", detail = "" }) {
  const safeTotal = Math.max(1, Number(total || 0));
  const width = Math.max(value > 0 ? 7 : 0, Math.round((value / safeTotal) * 100));

  return (
    <div className="grid gap-2">
      <div className="flex items-center justify-between gap-3">
        <div className="min-w-0">
          <div className="truncate text-[13px] font-semibold text-text">
            {label}
          </div>
          {detail ? (
            <div className="mt-0.5 truncate text-[11.5px] font-medium text-text-subtle">
              {detail}
            </div>
          ) : null}
        </div>
        <div className={cx("text-[13px] font-semibold", toneTextClass(tone))}>
          {value}
        </div>
      </div>

      <div className="h-2 overflow-hidden rounded-full bg-surface-subtle">
        <div
          className={cx(
            "h-full rounded-full transition-all duration-slow ease-premium",
            tone === "success"
              ? "bg-success"
              : tone === "warning"
                ? "bg-warning"
                : tone === "danger"
                  ? "bg-danger"
                  : "bg-brand"
          )}
          style={{ width: `${width}%` }}
        />
      </div>
    </div>
  );
}

