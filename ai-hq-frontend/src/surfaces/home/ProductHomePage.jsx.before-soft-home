}

export default function ProductHomePage() {
  const navigate = useNavigate();
  const home = useProductHome();

  const loading = home?.loading === true || home?.isLoading === true;
  const focus = useMemo(() => buildFocus(home), [home]);
  const channels = useMemo(() => normalizeChannels(home), [home]);

  function handleNavigate(path = "") {
    const target = s(path);
    if (!target) return;
    navigate(target);
  }

  if (loading) {
    return (
      <PageCanvas className="max-w-[1280px] py-3">
        <LoadingSurface title="Loading home" />
      </PageCanvas>
    );
  }

  return (
    <PageCanvas className="max-w-[1280px] space-y-4 py-3">
      {home?.availabilityNote ? (
        <InlineNotice
          tone="warning"
          title={home.availabilityNote.title}
          description={home.availabilityNote.description}
          compact
        />
      ) : null}

      <FocusPanel focus={focus} onNavigate={handleNavigate} />

      <Card padded={false} clip>
        <div className="grid border-b border-line-soft px-5 py-5 md:grid-cols-2 md:divide-x md:divide-line-soft xl:grid-cols-4">
          <Metric
            label="Open conversations"
            value={compact(openCount(home))}
            hint={`${compact(unreadCount(home))} unread`}
            icon={Inbox}
            tone={unreadCount(home) > 0 ? "warning" : "brand"}
          />

          <Metric
            label="Live channels"
            value={`${readyChannelCount(home)}/${availableChannelCount(home)}`}
            hint={`${connectedChannelCount(home)} connected`}
            icon={Globe2}
            tone={channelReady(home) ? "success" : "warning"}
          />

          <Metric
            label="AI status"
            value={aiReady(home) ? "Live" : "Guarded"}
            hint={businessReady(home) ? "Business info ready" : "Needs business info"}
            icon={Bot}
            tone={aiReady(home) ? "success" : "warning"}
          />

          <Metric
            label="Reply health"
            value={outboundAttention(home) > 0 ? "Review" : "Calm"}
            hint={`${compact(outboundAttention(home))} outbound actions`}
            icon={RefreshCw}
            tone={outboundAttention(home) > 0 ? "warning" : "success"}
          />
        </div>
      </Card>

      <div className="grid gap-4 xl:grid-cols-[minmax(0,1.08fr)_minmax(360px,0.92fr)]">
        <QueuePanel home={home} />
        <WorkspaceState home={home} onNavigate={handleNavigate} />
      </div>

      <ChannelsStrip channels={channels} onNavigate={handleNavigate} />
    </PageCanvas>
  );
}